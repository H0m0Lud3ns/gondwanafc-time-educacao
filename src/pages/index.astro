---
import '../styles/tailwind.css';
---
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Gondwana FC - Time da Educação</title>
  <link rel="canonical" href="https://www.gondwanafc.com/" />
