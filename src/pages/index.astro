  <script is:inline>
    const leadForm = document.querySelector('#lead-form');
    const formStatus = document.querySelector('#form-status');
    leadForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(leadForm);
      const formats = data.getAll('formato');
      const lines = [
        'Pedido pelo site Gondwana FC - Time da Educação',
        '',
        `Nome: ${data.get('nome') || ''}`,
        `Instituição: ${data.get('instituicao') || ''}`,
        `E-mail: ${data.get('email') || ''}`,
        `Cidade / país: ${data.get('territorio') || ''}`,
        `Formato de interesse: ${formats.length ? formats.join(', ') : 'não informado'}`,
        `Participantes: ${data.get('participantes') || 'não informado'}`,
        `Quando: ${data.get('quando') || 'não informado'}`,
        '',
        'Contexto:',
        data.get('mensagem') || ''
      ];
      const subject = encodeURIComponent('Pedido - Gondwana FC Time da Educação');
      const body = encodeURIComponent(lines.join('\n'));
      window.location.href = `mailto:contato.gondwana@gmail.com?subject=${subject}&body=${body}`;
      formStatus.textContent = 'Mensagem preparada. Se o e-mail não abrir, copie os dados preenchidos e envie para contato.gondwana@gmail.com.';
    });
  </script>
