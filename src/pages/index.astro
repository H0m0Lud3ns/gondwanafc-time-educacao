  <meta property="og:site_name" content="Gondwana FC - Time da Educação" />
  <meta property="og:title" content="Gondwana FC - Time da Educação" />
  <meta property="og:description" content="Vivências, oficinas, jornadas, formações e parcerias com futebol, audiovisual e território para escolas, clubes, projetos sociais e organizações." />
  <meta property="og:url" content="https://www.gondwanafc.com/" />
