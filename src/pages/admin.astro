<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Painel QA - Gondwana FC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,600..900,35&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root{--ink:#151d16;--leaf:#6f8d56;--lime:#d9ff5d;--sand:#f3ead3;--paper:#fff9ec;--clay:#b95f36;--line:rgba(21,29,22,.12);--soft:rgba(255,249,236,.78)}
    *{box-sizing:border-box}
    body{margin:0;overflow-x:hidden;font-family:Manrope,sans-serif;color:var(--ink);background:radial-gradient(circle at 10% 8%,rgba(217,255,93,.34),transparent 28rem),radial-gradient(circle at 96% 10%,rgba(185,95,54,.16),transparent 30rem),linear-gradient(135deg,#f7eed9,#fff9ec 46%,#e8eedc);min-height:100vh}
    .display{font-family:Fraunces,serif}.wrap{max-width:1440px;margin:auto;padding:20px}.hidden{display:none!important}
    .gate{position:fixed;inset:0;z-index:20;display:grid;place-items:center;background:rgba(21,29,22,.96);padding:22px}.gate-card{width:min(440px,100%);border-radius:32px;padding:28px;background:var(--paper);box-shadow:0 28px 90px rgba(0,0,0,.28)}
    .panel{background:var(--soft);backdrop-filter:blur(18px);border:1px solid var(--line);box-shadow:0 20px 70px rgba(21,29,22,.11);border-radius:30px;padding:18px}
    .top{position:relative;z-index:1;border-radius:34px;background:linear-gradient(135deg,#151d16,#26391f);color:var(--paper);padding:22px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:end;box-shadow:0 16px 44px rgba(21,29,22,.18)}
    .top h1{font-size:clamp(36px,4.8vw,64px);line-height:.92;margin:10px 0 0}.top p{max-width:720px;margin:10px 0 0;color:rgba(255,249,236,.78)}.top-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
    .pill{display:inline-flex;width:max-content;align-items:center;border-radius:999px;background:var(--lime);color:var(--ink);font-size:11px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;padding:8px 12px}
    .grid{display:grid;grid-template-columns:220px minmax(0,1fr) 390px;gap:18px;margin-top:18px;align-items:start}.nav{position:sticky;top:18px;z-index:2}.nav button,.btn{border:0;border-radius:999px;padding:13px 16px;font-weight:900;cursor:pointer;transition:transform .18s ease,background .18s ease,box-shadow .18s ease}.nav button:hover,.btn:hover{transform:translateY(-1px)}
    .nav button{display:block;width:100%;margin:7px 0;text-align:left;background:rgba(255,255,255,.42);color:var(--ink)}.nav button.active{background:var(--ink);color:var(--paper);box-shadow:0 10px 24px rgba(21,29,22,.18)}
    .btn.dark{background:var(--ink);color:var(--paper)}.btn.lime{background:var(--lime);color:var(--ink);box-shadow:0 10px 22px rgba(217,255,93,.16)}.top-actions .btn.lime:first-child{background:transparent;color:var(--lime);border:1px solid rgba(217,255,93,.55);box-shadow:none}.top-actions .btn.ghost{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);color:rgba(255,249,236,.86)}
    .section{display:none}.section.active{display:block}.section h2{font-size:clamp(30px,3vw,44px);line-height:.95;margin:14px 0 20px}.section h3{font-size:26px;margin:26px 0 12px}
    .field{width:100%;border:1px solid rgba(21,29,22,.16);border-radius:18px;background:rgba(255,255,255,.74);padding:14px 15px;font:inherit;box-shadow:inset 0 1px 0 rgba(255,255,255,.65)}.field:focus{outline:3px solid rgba(217,255,93,.9);border-color:rgba(21,29,22,.32)}
    label span{display:block;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.14em;color:var(--leaf);margin:0 0 7px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.full{grid-column:1/-1}.cards{display:grid;gap:14px}.item{border-radius:24px;background:rgba(255,255,255,.68);padding:14px;border:1px solid rgba(21,29,22,.08)}
    .photo-grid,.media-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:14px;align-items:stretch}.photo{overflow:hidden;border-radius:22px;background:rgba(255,255,255,.82);border:1px solid rgba(21,29,22,.08);text-align:left;cursor:pointer;padding:0;min-height:174px;box-shadow:0 8px 18px rgba(21,29,22,.06)}.photo.active{outline:4px solid var(--lime);outline-offset:-4px}.photo img,.media img{width:100%;aspect-ratio:4/3;height:auto;object-fit:cover;display:block;background:linear-gradient(135deg,rgba(21,29,22,.08),rgba(217,255,93,.18))}.photo strong,.media strong{display:block;padding:11px 12px;font-size:13px;line-height:1.2}
    aside{position:sticky;top:18px}.phone{border:10px solid var(--ink);border-radius:38px;overflow:hidden;background:var(--paper);box-shadow:0 30px 80px rgba(21,29,22,.24)}.preview{height:min(720px,calc(100vh - 54px));min-height:560px;overflow:auto}.hero{position:relative;min-height:500px;background:var(--ink);color:var(--paper);overflow:hidden}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.68}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(to bottom,transparent,rgba(21,29,22,.45),var(--ink))}.hero-content{position:relative;z-index:1;min-height:500px;display:flex;flex-direction:column;justify-content:end;padding:26px}.hero h2{font-size:48px;line-height:.9;margin:14px 0}.preview-section{padding:24px}.preview-card{border-radius:24px;background:var(--sand);padding:14px;margin:10px 0}.status{font-size:12px;line-height:1.6;background:rgba(21,29,22,.08);border-radius:18px;padding:13px;margin-top:16px}
    @media(max-width:1180px){.grid{grid-template-columns:200px minmax(0,1fr)}aside{grid-column:2;position:relative;top:auto}.preview{height:620px}}
    @media(max-width:860px){.wrap{padding:12px}.top{display:block;border-radius:26px}.top-actions{display:grid;grid-template-columns:1fr;gap:8px;margin-top:16px}.grid{grid-template-columns:1fr;gap:12px}.nav{position:relative;top:auto;display:flex;gap:8px;overflow-x:auto;padding:10px;border-radius:22px}.nav button{min-width:max-content;margin:0}.status{min-width:190px;margin:0}aside{position:relative;top:auto;grid-column:auto}.phone{border-width:0;border-radius:26px}.preview{height:auto;min-height:0;max-height:none}.form-grid{grid-template-columns:1fr}.btn{width:100%}}
    @media(max-width:560px){.top h1{font-size:38px}.panel{padding:14px;border-radius:22px}.hero,.hero-content{min-height:420px}.hero h2{font-size:40px}.photo-grid,.media-grid{grid-template-columns:1fr 1fr}.item div[style*="grid-template-columns:150px"]{grid-template-columns:1fr!important}.item div[style*="grid-template-columns:150px"]>img{height:180px!important}}
</style>
</head>
<body>
  <section id="gate" class="gate"><div class="gate-card"><span class="pill">CMS QA</span><h1 class="display" style="font-size:44px;line-height:.95;margin:18px 0 10px">Entrar no painel</h1><p>Senha provisória. Este QA salva no navegador e serve para validar a experiência editorial.</p><input id="password" class="field" type="password" placeholder="Senha" /><button id="enter" class="btn dark" style="width:100%;margin-top:12px">Entrar</button><p id="loginError" class="hidden" style="color:var(--clay);font-weight:900">Senha incorreta. Use: gondwana</p></div></section>
  <main class="wrap"><header class="top"><div><span class="pill">Gondwana FC</span><h1 class="display">CMS curado</h1><p>Editar tudo que é seguro: fotos, links, notícias, projetos, textos curtos e publicação QA.</p></div><div class="top-actions"><button id="save" class="btn lime">Salvar rascunho</button><button id="publish" class="btn lime">Publicar QA</button><button id="reset" class="btn ghost">Reset</button></div></header>
    <section class="grid"><nav class="panel nav"><button class="active" data-tab="home">Home</button><button data-tab="projects">Projetos</button><button data-tab="photos">Fotos do site</button><button data-tab="links">Links e notícias</button><button data-tab="media">Mídia</button><button data-tab="history">Histórico</button><div class="status"><b>Status:</b> <span id="status">rascunho local</span><br><b>Publicado QA:</b> <span id="pub">não</span></div></nav>
      <div class="panel">
        <section class="section active" id="home"><span class="pill">Home</span><h2 class="display">Capa principal</h2><div class="form-grid"><label><span>Título</span><input id="heroTitle" class="field"></label><label><span>Botão</span><input id="heroCta" class="field"></label><label class="full"><span>Texto</span><textarea id="heroBody" class="field" rows="4"></textarea></label></div><h3 class="display">Foto de capa</h3><div id="heroPhotos" class="photo-grid"></div></section>
        <section class="section" id="projects"><span class="pill">Projetos</span><h2 class="display">Cards editáveis</h2><div id="projectsList" class="cards"></div><button id="addProject" class="btn dark">Adicionar projeto</button></section>
        <section class="section" id="photos"><span class="pill">Fotos</span><h2 class="display">Todas as fotos modificáveis</h2><p>Cada foto tem local de uso, alt text e substituição por biblioteca ou upload.</p><div id="sitePhotos" class="cards"></div></section>
        <section class="section" id="links"><span class="pill">Links</span><h2 class="display">Notícias e links</h2><div id="linksList" class="cards"></div><button id="addLink" class="btn dark">Adicionar link/notícia</button></section>
        <section class="section" id="media"><span class="pill">Mídia</span><h2 class="display">Biblioteca</h2><label class="btn dark">Subir imagem<input id="upload" type="file" accept="image/*" hidden></label><div id="mediaGrid" class="media-grid" style="margin-top:16px"></div></section>
        <section class="section" id="history"><span class="pill">Histórico</span><h2 class="display">Versões QA</h2><div id="historyList" class="cards"></div></section>
      </div><aside><div class="phone"><div id="preview" class="preview"></div></div></aside></section></main>
<script>
const basePhotos=[{label:'Time no campo',src:'/legacy-assets/enviada-time-campo.jpg'},{label:'Oficina em sala',src:'/legacy-assets/enviada-oficina-sala.jpg'},{label:'Encontro de mãos',src:'/legacy-assets/27a017d7-encuentro-manos.jpg'},{label:'Bola nas mãos',src:'/legacy-assets/enviada-bola-maos.jpg'},{label:'Comunidade Gondwana',src:'/legacy-assets/26245046-comunidad-gondwana.jpg'}];
const initial={home:{title:'Gondwana FC em movimento',body:'Uma plataforma de educação, cultura e esporte para criar metodologias, narrativas e experiências com identidade latino-americana.',cta:'Conhecer projetos',photo:basePhotos[0].src},projects:[{id:'a-bola-conecta',title:'A Bola Conecta',desc:'Conteúdo, metodologia e audiovisual para formação pelo futebol.',featured:true},{id:'time-educacao',title:'Time da Educação',desc:'Percursos pedagógicos para escolas, clubes e territórios.',featured:true}],photos:[{id:'hero',label:'Capa principal',where:'Home / primeira dobra',src:basePhotos[0].src,alt:'Gondwana FC em formação e consultoria'},{id:'oficina',label:'Oficina',where:'Home / formação',src:basePhotos[1].src,alt:'Oficina educativa da Gondwana FC'},{id:'territorio',label:'Território',where:'Bloco territorial',src:basePhotos[2].src,alt:'Atuação territorial da Gondwana FC'},{id:'comunidade',label:'Comunidade',where:'Projetos / comunidade',src:basePhotos[4].src,alt:'Comunidade em atividade Gondwana FC'}],links:[{id:'home',label:'Home Gondwana FC',url:'/',type:'página interna',visible:true},{id:'caderno',label:'Caderno do Time',url:'/caderno/',type:'página interna',visible:true},{id:'noticia-modelo',label:'Notícia ou clipping externo',url:'https://exemplo.com/noticia',type:'notícia',visible:false}],uploads:[],history:[],published:null};
let state=JSON.parse(localStorage.getItem('gfc-cms-qa')||'null')||structuredClone(initial);const $=s=>document.querySelector(s);const $$=s=>Array.from(document.querySelectorAll(s));const esc=v=>String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));const photos=()=>[...basePhotos,...state.uploads];
function save(){localStorage.setItem('gfc-cms-qa',JSON.stringify(state));$('#status').textContent='rascunho salvo neste navegador'}function mark(){$('#status').textContent='alterações não salvas';renderPreview()}function renderAll(){renderHome();renderProjects();renderPhotos();renderLinks();renderMedia();renderHistory();renderPreview();$('#pub').textContent=state.published?'sim':'não'}
function renderHome(){$('#heroTitle').value=state.home.title;$('#heroBody').value=state.home.body;$('#heroCta').value=state.home.cta;$('#heroTitle').oninput=e=>{state.home.title=e.target.value;mark()};$('#heroBody').oninput=e=>{state.home.body=e.target.value;mark()};$('#heroCta').oninput=e=>{state.home.cta=e.target.value;mark()};const grid=$('#heroPhotos');grid.innerHTML='';photos().forEach(p=>{const b=document.createElement('button');b.className='photo'+(p.src===state.home.photo?' active':'');b.innerHTML=`<img src="${p.src}"><strong>${esc(p.label)}</strong>`;b.onclick=()=>{state.home.photo=p.src;const hero=state.photos.find(x=>x.id==='hero');if(hero)hero.src=p.src;mark();renderAll()};grid.appendChild(b)})}
function renderProjects(){const list=$('#projectsList');list.innerHTML='';state.projects.forEach((p,i)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Título</span><input class="field" value="${esc(p.title)}"></label><label><span>Descrição</span><input class="field" value="${esc(p.desc)}"></label><label><input type="checkbox" ${p.featured?'checked':''}> destaque</label></div><button class="btn dark" style="margin-top:10px">Remover</button>`;const inputs=el.querySelectorAll('input');inputs[0].oninput=e=>{p.title=e.target.value;mark()};inputs[1].oninput=e=>{p.desc=e.target.value;mark()};inputs[2].onchange=e=>{p.featured=e.target.checked;mark()};el.querySelector('button').onclick=()=>{state.projects.splice(i,1);mark();renderProjects();renderPreview()};list.appendChild(el)})}
function renderPhotos(){const list=$('#sitePhotos');list.innerHTML='';state.photos.forEach(p=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div style="display:grid;grid-template-columns:150px 1fr;gap:14px"><img src="${p.src}" style="width:100%;height:130px;object-fit:cover;border-radius:18px"><div class="form-grid"><label><span>Nome</span><input class="field" value="${esc(p.label)}"></label><label><span>Onde aparece</span><input class="field" value="${esc(p.where)}"></label><label class="full"><span>Alt text</span><input class="field" value="${esc(p.alt)}"></label><label><span>Escolher da biblioteca</span><select class="field">${photos().map(x=>`<option value="${esc(x.src)}" ${x.src===p.src?'selected':''}>${esc(x.label)}</option>`).join('')}</select></label><label><span>Substituir por upload</span><input class="field" type="file" accept="image/*"></label></div></div>`;const fields=el.querySelectorAll('input,select');fields[0].oninput=e=>{p.label=e.target.value;mark()};fields[1].oninput=e=>{p.where=e.target.value;mark()};fields[2].oninput=e=>{p.alt=e.target.value;mark()};fields[3].onchange=e=>{p.src=e.target.value;if(p.id==='hero')state.home.photo=p.src;mark();renderAll()};fields[4].onchange=e=>handleUpload(e,p);list.appendChild(el)})}
function renderLinks(){const list=$('#linksList');list.innerHTML='';state.links.forEach((l,i)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Título</span><input class="field" value="${esc(l.label)}"></label><label><span>URL</span><input class="field" value="${esc(l.url)}"></label><label><span>Tipo</span><select class="field">${['notícia','página interna','institucional','parceiro'].map(t=>`<option ${l.type===t?'selected':''}>${t}</option>`).join('')}</select></label><label><input type="checkbox" ${l.visible?'checked':''}> ativo</label></div><button class="btn dark" style="margin-top:10px">Remover</button>`;const f=el.querySelectorAll('input,select');f[0].oninput=e=>{l.label=e.target.value;mark()};f[1].oninput=e=>{l.url=e.target.value;mark()};f[2].onchange=e=>{l.type=e.target.value;mark()};f[3].onchange=e=>{l.visible=e.target.checked;mark()};el.querySelector('button').onclick=()=>{state.links.splice(i,1);mark();renderLinks();renderPreview()};list.appendChild(el)})}
function renderMedia(){const grid=$('#mediaGrid');grid.innerHTML='';photos().forEach(p=>{const el=document.createElement('div');el.className='media item';el.innerHTML=`<img src="${p.src}"><strong>${esc(p.label)}</strong>`;grid.appendChild(el)})}function renderHistory(){const list=$('#historyList');list.innerHTML='';if(!state.history.length){list.innerHTML='<p class="item">Sem versões ainda.</p>';return}state.history.forEach((h,i)=>{const b=document.createElement('button');b.className='item';b.style.textAlign='left';b.innerHTML=`<b>${esc(h.title)}</b><br><small>${h.when}</small>`;b.onclick=()=>{state=structuredClone(h.snapshot);save();renderAll()};list.appendChild(b)})}
function renderPreview(){const activeLinks=state.links.filter(l=>l.visible);$('#preview').innerHTML=`<section class="hero"><img src="${state.home.photo}"><div class="hero-content"><span class="pill">Gondwana FC</span><h2 class="display">${esc(state.home.title)}</h2><p>${esc(state.home.body)}</p><button class="btn lime">${esc(state.home.cta)}</button></div></section><section class="preview-section"><h2 class="display">Projetos</h2>${state.projects.filter(p=>p.featured).map(p=>`<article class="preview-card"><b>${esc(p.title)}</b><p>${esc(p.desc)}</p></article>`).join('')}<h2 class="display">Fotos controladas</h2><div class="photo-grid">${state.photos.map(p=>`<div class="media item"><img src="${p.src}"><strong>${esc(p.label)}</strong></div>`).join('')}</div><h2 class="display">Links ativos</h2>${activeLinks.map(l=>`<a class="preview-card" style="display:block;color:var(--ink);text-decoration:none" href="${esc(l.url)}"><b>${esc(l.label)}</b><br><small>${esc(l.type)}</small></a>`).join('')}</section>`}
function handleUpload(e,targetPhoto){const file=e.target.files&&e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{const upload={label:file.name.replace(/\.[^.]+$/,''),src:reader.result};state.uploads.unshift(upload);if(targetPhoto){targetPhoto.src=upload.src;if(targetPhoto.id==='hero')state.home.photo=upload.src}mark();renderAll()};reader.readAsDataURL(file)}
$$('.nav button').forEach(b=>b.onclick=()=>{$$('.nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');$$('.section').forEach(s=>s.classList.remove('active'));$('#'+b.dataset.tab).classList.add('active')});$('#enter').onclick=()=>{$('#password').value.trim().toLowerCase()==='gondwana'?$('#gate').classList.add('hidden'):$('#loginError').classList.remove('hidden')};$('#password').onkeydown=e=>{if(e.key==='Enter')$('#enter').click()};$('#save').onclick=save;$('#publish').onclick=()=>{state.published=new Date().toISOString();state.history.unshift({when:new Date().toLocaleString('pt-BR'),title:state.home.title,snapshot:structuredClone(state)});state.history=state.history.slice(0,8);save();renderAll()};$('#reset').onclick=()=>{state=structuredClone(initial);localStorage.removeItem('gfc-cms-qa');renderAll()};$('#addProject').onclick=()=>{state.projects.push({id:'p-'+Date.now(),title:'Novo projeto',desc:'Descrição curta.',featured:true});mark();renderProjects();renderPreview()};$('#addLink').onclick=()=>{state.links.push({id:'l-'+Date.now(),label:'Novo link',url:'https://',type:'notícia',visible:false});mark();renderLinks();renderPreview()};$('#upload').onchange=e=>handleUpload(e,null);renderAll();
</script>
</body>
</html>
