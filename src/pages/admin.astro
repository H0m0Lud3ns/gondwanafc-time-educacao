function renderSiteMap(){
  const list=$('#siteMapList');list.innerHTML='';
  state.siteMap.forEach(page=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Página</span><input class="field" value="${esc(page.page)}"></label><label><span>Rota</span><input class="field" value="${esc(page.path)}"></label><label><span>Status</span><select class="field">${['publicada','rascunho','apoio','arquivada'].map(x=>`<option ${page.status===x?'selected':''}>${x}</option>`).join('')}</select></label><label><span>Risco de edição</span><select class="field">${['baixo','médio','alto'].map(x=>`<option ${page.risk===x?'selected':''}>${x}</option>`).join('')}</select></label></div><div class="cards" style="margin-top:14px">${(page.sections||[]).map((sec,i)=>`<div class="item"><b>${esc(sec.name)}</b><p><small>${esc(sec.type)} · risco ${esc(page.risk)}</small></p><p><b>Campos:</b> ${esc(sec.fields)}</p><p><b>Mídia:</b> ${esc(sec.media)}</p><p><b>Links:</b> ${esc(sec.links)}</p><button class="btn dark" data-section="${i}" type="button">Remover seção</button></div>`).join('')}</div><button class="btn dark" style="margin-top:12px" type="button">Adicionar seção</button>`;
  const f=el.querySelectorAll('input,select');f[0].oninput=e=>{page.page=e.target.value;mark()};f[1].oninput=e=>{page.path=e.target.value;mark()};f[2].onchange=e=>{page.status=e.target.value;mark()};f[3].onchange=e=>{page.risk=e.target.value;mark()};el.querySelectorAll('[data-section]').forEach(btn=>btn.onclick=()=>{page.sections.splice(Number(btn.dataset.section),1);mark();renderSiteMap();renderPreview()});el.querySelector('button:not([data-section])').onclick=()=>{page.sections=page.sections||[];page.sections.push({name:'Nova seção',type:'conteúdo',fields:'definir campos editáveis',media:'definir relação com biblioteca',links:'definir links'});mark();renderSiteMap()};list.appendChild(el)})
