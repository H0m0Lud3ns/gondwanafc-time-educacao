  allPhotos().forEach(p=>{const b=document.createElement('button');b.className='photo'+(p.src===state.home.photo?' active':'');b.innerHTML=`<img src="${esc(p.src)}"><strong>${esc(p.label)}</strong>`;b.onclick=()=>{state.home.photo=p.src;mark();renderAll()};grid.appendChild(b)})
