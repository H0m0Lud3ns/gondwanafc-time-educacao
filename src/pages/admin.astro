$('#save').onclick=()=>{save();renderAll()};
$('#publish').onclick=()=>{state.published=new Date().toISOString();state.history.unshift({when:new Date().toLocaleString('pt-BR'),title:state.home.title||'Versão local',snapshot:structuredClone(state)});state.history=state.history.slice(0,8);save();renderAll();window.alert('Versão local salva neste navegador. Ainda não foi publicada em produção.')};
$('#publishProduction').onclick=async()=>{const password=window.prompt('Senha para publicar em produção');if(!password)return;$('#status').textContent='comprimindo imagens e publicando...';try{await compressStateImages();save();const isValid=await validateDraft(false);if(!isValid)throw new Error('Corrija os erros de validação antes de publicar.');const payload={password,publicPresence:state.publicPresence,photos:state.photos,sitePhotos:state.sitePhotos,imageUses:state.imageUses,seo:state.seo,home:state.home,projects:state.projects,links:state.links,siteMap:state.siteMap,uploads:state.uploads};const response=await fetch('/api/cms/publish-presence',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const raw=await response.text();let result={};try{result=raw?JSON.parse(raw):{}}catch{throw new Error(responseErrorMessage(raw,response.status))}if(!response.ok||!result.ok)throw new Error(result.error||responseErrorMessage(raw,response.status));$('#status').textContent=`produção publicada: ${result.count} registros e ${result.photos||0} fotos`;state.history.unshift({when:new Date().toLocaleString('pt-BR'),title:'Publicação produção',snapshot:structuredClone(state),commit:result.commit});state.history=state.history.slice(0,8);save();renderAll();window.alert('Publicado em produção. A Vercel vai atualizar o site após o deploy automático.');}catch(error){$('#status').textContent='falha ao publicar em produção';window.alert(error.message||'Falha ao publicar em produção')}};
$('#reset').onclick=()=>{state=structuredClone(initial);localStorage.removeItem('gfc-cms-qa');renderAll()};
$('#validateDraft').onclick=()=>validateDraft(true);
$('#imageSearch')?.addEventListener('input',()=>renderPhotos());
$('#imagePageFilter')?.addEventListener('change',()=>renderPhotos());
$('#addProject').onclick=()=>{state.projects.push({id:'p-'+Date.now(),title:'Novo projeto',desc:'Descrição curta.',featured:true});mark();renderProjects();renderPreview()};
$('#addLink').onclick=()=>{state.links.unshift({id:'l-'+Date.now(),label:'Nova notícia',title:'Nova notícia',url:'https://',type:'notícia',category:'Clipping',date:new Date().toISOString().slice(0,10),source:'',excerpt:'Resumo curto da publicação.',visible:false,featured:false});mark();renderLinks();renderPreview()};
$('#addPresence').onclick=()=>{state.publicPresence.unshift({id:'p-'+Date.now(),vehicle:'Novo veículo',tier:'Clipping',title:'Título do registro público',url:'https://',visible:true});mark();renderPresence();renderPreview()};
$('#upload').onchange=e=>handleUpload(e,null);
if(isAuthed())unlock();
renderAll();
</script>
</body>
</html>
