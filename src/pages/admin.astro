let state=JSON.parse(localStorage.getItem('gfc-cms-qa')||'null')||structuredClone(initial);function normalizeState(){state.home={...initial.home,...(state.home||{})};state.seo={...initial.seo,...(state.seo||{})};state.projects=Array.isArray(state.projects)?state.projects:structuredClone(initial.projects);state.photos=Array.isArray(state.photos)?state.photos:structuredClone(initial.photos);state.links=Array.isArray(state.links)?state.links:[];const byId=new Set(state.links.map(l=>l.id));initial.links.forEach(l=>{if(!byId.has(l.id))state.links.push(structuredClone(l))});state.links=state.links.map(l=>({title:l.title||l.label||'Sem título',category:l.category||l.type||'Geral',date:l.date||'',source:l.source||'',excerpt:l.excerpt||'',featured:!!l.featured,visible:l.visible!==false,...l,label:l.label||l.title||'Sem título'}));state.siteMap=Array.isArray(state.siteMap)?state.siteMap:structuredClone(initial.siteMap);state.publicPresence=Array.isArray(state.publicPresence)?state.publicPresence:[];const presenceIds=new Set(state.publicPresence.map(i=>i.id));initial.publicPresence.forEach(i=>{if(!presenceIds.has(i.id))state.publicPresence.push(structuredClone(i))});state.publicPresence=state.publicPresence.map(i=>({vehicle:i.vehicle||'Novo veículo',tier:i.tier||'Clipping',title:i.title||'Título do registro',url:i.url||'https://',visible:i.visible!==false,...i}));state.uploads=Array.isArray(state.uploads)?state.uploads:[];state.history=Array.isArray(state.history)?state.history:[]}normalizeState();const $=s=>document.querySelector(s);const $$=s=>Array.from(document.querySelectorAll(s));const esc=v=>String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));const photos=()=>[...basePhotos,...state.uploads];
function save(){localStorage.setItem('gfc-cms-qa',JSON.stringify(state));$('#status').textContent='rascunho salvo neste navegador'}function mark(){$('#status').textContent='alterações não salvas';renderPreview()}function renderAll(){renderHome();renderSiteMap();renderProjects();renderPhotos();renderLinks();renderPresence();renderSeo();renderMedia();renderHistory();renderPreview();$('#pub').textContent=state.published?'sim':'não'}
function renderSiteMap(){const list=$('#siteMapList');if(!list)return;list.innerHTML='';state.siteMap.forEach((page,pageIndex)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Página</span><input class="field" value="${esc(page.page)}"></label><label><span>Rota</span><input class="field" value="${esc(page.path)}"></label><label><span>Status</span><select class="field">${['publicada','rascunho','apoio','arquivada'].map(x=>`<option ${page.status===x?'selected':''}>${x}</option>`).join('')}</select></label><label><span>Risco de edição</span><select class="field">${['baixo','médio','alto'].map(x=>`<option ${page.risk===x?'selected':''}>${x}</option>`).join('')}</select></label></div><div class="cards" style="margin-top:14px">${page.sections.map((sec,i)=>`<div class="item"><b>${esc(sec.name)}</b><p><small>${esc(sec.type)} · risco ${esc(page.risk)}</small></p><p><b>Campos:</b> ${esc(sec.fields)}</p><p><b>Mídia:</b> ${esc(sec.media)}</p><p><b>Links:</b> ${esc(sec.links)}</p><button class="btn dark" data-section="${i}" type="button">Remover seção</button></div>`).join('')}</div><button class="btn dark" style="margin-top:12px" type="button">Adicionar seção</button>`;const f=el.querySelectorAll('input,select');f[0].oninput=e=>{page.page=e.target.value;mark()};f[1].oninput=e=>{page.path=e.target.value;mark()};f[2].onchange=e=>{page.status=e.target.value;mark()};f[3].onchange=e=>{page.risk=e.target.value;mark()};el.querySelectorAll('[data-section]').forEach(btn=>btn.onclick=()=>{page.sections.splice(Number(btn.dataset.section),1);mark();renderSiteMap();renderPreview()});el.querySelector('button:not([data-section])').onclick=()=>{page.sections.push({name:'Nova seção',type:'conteúdo',fields:'definir campos editáveis',media:'definir relação com biblioteca',links:'definir links'});mark();renderSiteMap()};list.appendChild(el)})}
function renderHome(){$('#heroTitle').value=state.home.title;$('#heroBody').value=state.home.body;$('#heroCta').value=state.home.cta;$('#heroTitle').oninput=e=>{state.home.title=e.target.value;mark()};$('#heroBody').oninput=e=>{state.home.body=e.target.value;mark()};$('#heroCta').oninput=e=>{state.home.cta=e.target.value;mark()};const grid=$('#heroPhotos');grid.innerHTML='';photos().forEach(p=>{const b=document.createElement('button');b.className='photo'+(p.src===state.home.photo?' active':'');b.innerHTML=`<img src="${p.src}"><strong>${esc(p.label)}</strong>`;b.onclick=()=>{state.home.photo=p.src;const hero=state.photos.find(x=>x.id==='hero');if(hero)hero.src=p.src;mark();renderAll()};grid.appendChild(b)})}
function renderProjects(){const list=$('#projectsList');list.innerHTML='';state.projects.forEach((p,i)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Título</span><input class="field" value="${esc(p.title)}"></label><label><span>Descrição</span><input class="field" value="${esc(p.desc)}"></label><label><input type="checkbox" ${p.featured?'checked':''}> destaque</label></div><button class="btn dark" style="margin-top:10px">Remover</button>`;const inputs=el.querySelectorAll('input');inputs[0].oninput=e=>{p.title=e.target.value;mark()};inputs[1].oninput=e=>{p.desc=e.target.value;mark()};inputs[2].onchange=e=>{p.featured=e.target.checked;mark()};el.querySelector('button').onclick=()=>{state.projects.splice(i,1);mark();renderProjects();renderPreview()};list.appendChild(el)})}
function renderPhotos(){const list=$('#sitePhotos');list.innerHTML='';state.photos.forEach(p=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div style="display:grid;grid-template-columns:150px 1fr;gap:14px"><img src="${p.src}" style="width:100%;height:130px;object-fit:cover;border-radius:18px"><div class="form-grid"><label><span>Nome</span><input class="field" value="${esc(p.label)}"></label><label><span>Onde aparece</span><input class="field" value="${esc(p.where)}"></label><label class="full"><span>Alt text</span><input class="field" value="${esc(p.alt)}"></label><label><span>Escolher da biblioteca</span><select class="field">${photos().map(x=>`<option value="${esc(x.src)}" ${x.src===p.src?'selected':''}>${esc(x.label)}</option>`).join('')}</select></label><label><span>Substituir por upload</span><input class="field" type="file" accept="image/*"></label></div></div>`;const fields=el.querySelectorAll('input,select');fields[0].oninput=e=>{p.label=e.target.value;mark()};fields[1].oninput=e=>{p.where=e.target.value;mark()};fields[2].oninput=e=>{p.alt=e.target.value;mark()};fields[3].onchange=e=>{p.src=e.target.value;if(p.id==='hero')state.home.photo=p.src;mark();renderAll()};fields[4].onchange=e=>handleUpload(e,p);list.appendChild(el)})}
function renderLinks(){const list=$('#linksList');list.innerHTML='';state.links.forEach((l,i)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Título público</span><input class="field" value="${esc(l.title||l.label)}"></label><label><span>Categoria</span><input class="field" value="${esc(l.category||'')}"></label><label class="full"><span>Resumo</span><textarea class="field" rows="3">${esc(l.excerpt||'')}</textarea></label><label><span>URL</span><input class="field" value="${esc(l.url)}"></label><label><span>Tipo</span><select class="field">${['artigo','notícia','guia','relato','menu','página interna','rede social','parceiro'].map(t=>`<option ${l.type===t?'selected':''}>${t}</option>`).join('')}</select></label><label><span>Fonte</span><input class="field" value="${esc(l.source||'')}"></label><label><span>Data</span><input class="field" type="date" value="${esc(l.date||'')}"></label><label><input type="checkbox" ${l.visible?'checked':''}> publicado/visível</label><label><input type="checkbox" ${l.featured?'checked':''}> destaque</label></div><button class="btn dark" style="margin-top:10px">Remover</button>`;const f=el.querySelectorAll('input,textarea,select');f[0].oninput=e=>{l.title=e.target.value;l.label=e.target.value;mark()};f[1].oninput=e=>{l.category=e.target.value;mark()};f[2].oninput=e=>{l.excerpt=e.target.value;mark()};f[3].oninput=e=>{l.url=e.target.value;mark()};f[4].onchange=e=>{l.type=e.target.value;mark()};f[5].oninput=e=>{l.source=e.target.value;mark()};f[6].oninput=e=>{l.date=e.target.value;mark()};f[7].onchange=e=>{l.visible=e.target.checked;mark()};f[8].onchange=e=>{l.featured=e.target.checked;mark()};el.querySelector('button').onclick=()=>{state.links.splice(i,1);mark();renderLinks();renderPreview()};list.appendChild(el)})}
function renderPresence(){const list=$('#presenceList');if(!list)return;list.innerHTML='';state.publicPresence.forEach((item,i)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Veículo</span><input class="field" value="${esc(item.vehicle)}"></label><label><span>Tier / tipo</span><input class="field" value="${esc(item.tier)}"></label><label class="full"><span>Título do card</span><textarea class="field" rows="3">${esc(item.title)}</textarea></label><label class="full"><span>URL original</span><input class="field" value="${esc(item.url)}"></label><label><input type="checkbox" ${item.visible?'checked':''}> visível na home</label></div><button class="btn dark" style="margin-top:10px">Remover</button>`;const f=el.querySelectorAll('input,textarea');f[0].oninput=e=>{item.vehicle=e.target.value;mark()};f[1].oninput=e=>{item.tier=e.target.value;mark()};f[2].oninput=e=>{item.title=e.target.value;mark()};f[3].oninput=e=>{item.url=e.target.value;mark()};f[4].onchange=e=>{item.visible=e.target.checked;mark()};el.querySelector('button').onclick=()=>{state.publicPresence.splice(i,1);mark();renderPresence();renderPreview()};list.appendChild(el)})}
function renderSeo(){if(!$('#seoTitle'))return;$('#seoTitle').value=state.seo.title;$('#seoDescription').value=state.seo.description;$('#seoCanonical').value=state.seo.canonical;$('#seoRobots').value=state.seo.robots;$('#seoOgImage').value=state.seo.ogImage;$('#seoTitle').oninput=e=>{state.seo.title=e.target.value;mark()};$('#seoDescription').oninput=e=>{state.seo.description=e.target.value;mark()};$('#seoCanonical').oninput=e=>{state.seo.canonical=e.target.value;mark()};$('#seoRobots').onchange=e=>{state.seo.robots=e.target.value;mark()};$('#seoOgImage').oninput=e=>{state.seo.ogImage=e.target.value;mark()}}
function renderMedia(){const grid=$('#mediaGrid');grid.innerHTML='';photos().forEach(p=>{const el=document.createElement('div');el.className='media item';el.innerHTML=`<img src="${p.src}"><strong>${esc(p.label)}</strong><p><b>Uso:</b> ${esc(p.usage||'Imagem disponível')}</p><p><b>Seção:</b> ${esc(p.section||'Biblioteca geral')}</p><p><b>Tipo:</b> ${esc(p.type||'upload')}</p><p><b>Risco:</b> ${esc(p.risk||'revisar antes de publicar')}</p><p><b>Alt:</b> ${esc(p.alt||'pendente')}</p><button class="btn dark" type="button">Usar como capa</button>`;el.querySelector('button').onclick=()=>{state.home.photo=p.src;const hero=state.photos.find(x=>x.id==='hero');if(hero){hero.src=p.src;hero.alt=p.alt||hero.alt}mark();renderAll()};grid.appendChild(el)})}
function renderHistory(){const list=$('#historyList');list.innerHTML='';if(!state.history.length){list.innerHTML='<p class="item">Sem versões ainda.</p>';return}state.history.forEach((h,i)=>{const b=document.createElement('button');b.className='item';b.style.textAlign='left';b.innerHTML=`<b>${esc(h.title)}</b><br><small>${h.when}</small>`;b.onclick=()=>{state=structuredClone(h.snapshot);save();renderAll()};list.appendChild(b)})}
function renderPreview(){const activeLinks=state.links.filter(l=>l.visible);$('#preview').innerHTML=`<section class="hero"><img src="${state.home.photo}"><div class="hero-content"><span class="pill">Gondwana FC</span><h2 class="display">${esc(state.home.title)}</h2><p>${esc(state.home.body)}</p><button class="btn lime">${esc(state.home.cta)}</button></div></section><section class="preview-section"><h2 class="display">Projetos</h2>${state.projects.filter(p=>p.featured).map(p=>`<article class="preview-card"><b>${esc(p.title)}</b><p>${esc(p.desc)}</p></article>`).join('')}<h2 class="display">Fotos controladas</h2><div class="photo-grid">${state.photos.map(p=>`<div class="media item"><img src="${p.src}"><strong>${esc(p.label)}</strong></div>`).join('')}</div><h2 class="display">Links e notícias ativos</h2>${activeLinks.map(l=>`<a class="preview-card" style="display:block;color:var(--ink);text-decoration:none" href="${esc(l.url)}"><small>${esc(l.category||l.type)} ${l.featured?'• destaque':''}</small><br><b>${esc(l.title||l.label)}</b><p>${esc(l.excerpt||'')}</p></a>`).join('')}<h2 class="display">Presença pública</h2>${state.publicPresence.filter(i=>i.visible).map(i=>`<a class="preview-card" style="display:block;color:var(--ink);text-decoration:none" href="${esc(i.url)}"><small>${esc(i.vehicle)} · ${esc(i.tier)}</small><br><b>${esc(i.title)}</b></a>`).join('')}</section>`}
function handleUpload(e,targetPhoto){const file=e.target.files&&e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{const upload={label:file.name.replace(/\.[^.]+$/,''),src:reader.result};state.uploads.unshift(upload);if(targetPhoto){targetPhoto.src=upload.src;if(targetPhoto.id==='hero')state.home.photo=upload.src}save();renderAll()};reader.readAsDataURL(file)}
$$('.nav button').forEach(b=>b.onclick=()=>{$$('.nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');$$('.section').forEach(s=>s.classList.remove('active'));$('#'+b.dataset.tab).classList.add('active')});$('#enter').onclick=()=>{$('#password').value.trim().toLowerCase()==='gondwana'?$('#gate').classList.add('hidden'):$('#loginError').classList.remove('hidden')};$('#password').onkeydown=e=>{if(e.key==='Enter')$('#enter').click()};$('#save').onclick=()=>{save();renderAll()};$('#publish').onclick=()=>{state.published=new Date().toISOString();state.history.unshift({when:new Date().toLocaleString('pt-BR'),title:state.home.title,snapshot:structuredClone(state)});state.history=state.history.slice(0,8);save();renderAll()};$('#publishProduction').onclick=async()=>{const password=window.prompt('Senha para publicar em produção');if(!password)return;$('#status').textContent='publicando presença pública em produção...';try{const response=await fetch('/api/cms/publish-presence',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({password,publicPresence:state.publicPresence})});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.error||'Falha ao publicar');$('#status').textContent=`produção publicada: ${result.count} registros`;state.history.unshift({when:new Date().toLocaleString('pt-BR'),title:'Publicação produção - presença pública',snapshot:structuredClone(state),commit:result.commit});state.history=state.history.slice(0,8);save();renderAll();window.alert('Publicado em produção. A Vercel vai atualizar o site após o deploy automático.');}catch(error){$('#status').textContent='falha ao publicar em produção';window.alert(error.message||'Falha ao publicar em produção')}};$('#reset').onclick=()=>{state=structuredClone(initial);localStorage.removeItem('gfc-cms-qa');renderAll()};$('#addProject').onclick=()=>{state.projects.push({id:'p-'+Date.now(),title:'Novo projeto',desc:'Descrição curta.',featured:true});mark();renderProjects();renderPreview()};$('#addLink').onclick=()=>{state.links.unshift({id:'l-'+Date.now(),label:'Nova notícia',title:'Nova notícia',url:'https://',type:'notícia',category:'Clipping',date:new Date().toISOString().slice(0,10),source:'',excerpt:'Resumo curto da publicação.',visible:false,featured:false});mark();renderLinks();renderPreview()};$('#addPresence').onclick=()=>{state.publicPresence.unshift({id:'p-'+Date.now(),vehicle:'Novo veículo',tier:'Clipping',title:'Título do registro público',url:'https://',visible:true});mark();renderPresence();renderPreview()};$('#upload').onchange=e=>handleUpload(e,null);renderAll();
</script>
