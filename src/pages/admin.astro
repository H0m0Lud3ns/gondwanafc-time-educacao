function renderProjects(){const list=$('#projectsList');list.innerHTML='';state.projects.forEach((p,i)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Título</span><input class="field" value="${esc(p.title)}"></label><label><span>Descrição</span><input class="field" value="${esc(p.desc)}"></label><label><input type="checkbox" ${p.featured?'checked':''}> destaque</label></div><button class="btn dark" style="margin-top:10px">Remover</button>`;const inputs=el.querySelectorAll('input');inputs[0].oninput=e=>{p.title=e.target.value;mark()};inputs[1].oninput=e=>{p.desc=e.target.value;mark()};inputs[2].onchange=e=>{p.featured=e.target.checked;mark()};el.querySelector('button').onclick=()=>{state.projects.splice(i,1);mark();renderProjects();renderPreview()};list.appendChild(el)})}
function renderImageFilters(slots){
  const pageFilter=$('#imagePageFilter');if(!pageFilter)return;
  const current=pageFilter.value||'';
  const pages=[...new Set(slots.map(s=>s.page||'Sem página'))].sort();
  pageFilter.innerHTML='<option value="">Todas as páginas</option>'+pages.map(page=>`<option value="${esc(page)}" ${page===current?'selected':''}>${esc(page)}</option>`).join('');
}
function filteredImageUses(){
  const slots=editableImageUses();
  const query=String($('#imageSearch')?.value||'').trim().toLowerCase();
  const page=String($('#imagePageFilter')?.value||'');
  return slots.filter(slot=>{
    const haystack=[slot.label,slot.page,slot.section,slot.id,slot.alt].join(' ').toLowerCase();
    return (!page||slot.page===page)&&(!query||haystack.includes(query));
  });
}
function renderPhotos(){
  const list=$('#sitePhotos');list.innerHTML='';
  const allSlots=editableImageUses();renderImageFilters(allSlots);
  const slots=filteredImageUses();
  const count=$('#imageSlotCount');if(count)count.textContent=`${slots.length} de ${allSlots.length} lugares editáveis visíveis.`;
  if(!slots.length){list.innerHTML='<p class="item">Nenhum lugar encontrado com esse filtro.</p>';return}
  let currentGroup='';
  slots.forEach((p)=>{const group=p.page||'Sem página';if(group!==currentGroup){currentGroup=group;const heading=document.createElement('div');heading.className='item';heading.innerHTML=`<b style="color:var(--ouro);letter-spacing:.14em;text-transform:uppercase">${esc(group)}</b>`;list.appendChild(heading)}const currentSrc=p.src;const options=allPhotos();const el=document.createElement('article');el.className='item';el.innerHTML=`<div style="display:grid;grid-template-columns:170px 1fr;gap:16px;align-items:start"><div><img src="${esc(currentSrc)}" style="width:100%;height:150px;object-fit:cover;border-radius:18px"><p style="font-size:12px;line-height:1.35;color:rgba(246,237,215,.68)"><b>Slot:</b><br>${esc(p.id)}</p></div><div><h3 class="display" style="font-size:24px;margin:0 0 8px">${esc(p.label||p.id)}</h3><p style="margin:0 0 12px;color:rgba(246,237,215,.72)"><b>Onde aparece:</b> ${esc([p.page,p.section].filter(Boolean).join(' · ')||'Uso conectado no site')}</p><div class="form-grid"><label><span>Escolher nova imagem</span><select class="field" data-role="select">${options.map(x=>`<option value="${esc(x.src)}" ${x.src===currentSrc?'selected':''}>${esc(x.label||x.id||x.src)}</option>`).join('')}</select></label><label><span>Subir e trocar por nova imagem</span><input class="field" type="file" accept="image/*" data-role="upload"></label></div><div data-role="preview" class="item" style="margin-top:12px;display:grid;grid-template-columns:120px 1fr;gap:12px;align-items:center"><img src="${esc(currentSrc)}" style="width:120px;height:82px;object-fit:cover;border-radius:14px"><div><b>Depois</b><p style="margin:.35rem 0 0;color:rgba(246,237,215,.68)">Escolha uma imagem da biblioteca e confirme a troca.</p></div></div><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px"><button class="btn dark" type="button" data-role="apply">Confirmar troca neste lugar</button><button class="btn ghost" type="button" data-role="details">Editar informações avançadas</button></div><div data-role="advanced" class="form-grid hidden" style="margin-top:12px"><label><span>Nome visível no painel</span><input class="field" value="${esc(p.label||'')}" data-role="label"></label><label><span>Seção</span><input class="field" value="${esc(p.section||'')}" data-role="section"></label><label><span>Página</span><input class="field" value="${esc(p.page||'')}" data-role="page"></label><label class="full"><span>Alt text</span><input class="field" value="${esc(p.alt||'')}" data-role="alt"></label><label class="full"><span>Fallback original conectado</span><input class="field" value="${esc(p.original||p.src)}" readonly></label></div></div></div>`;
    const select=el.querySelector('[data-role="select"]');const preview=el.querySelector('[data-role="preview"]');const selected=()=>options.find(x=>x.src===select.value)||{src:select.value,label:'Imagem selecionada'};
    const renderSelectedPreview=()=>{const item=selected();preview.innerHTML=`<img src="${esc(item.src)}" style="width:120px;height:82px;object-fit:cover;border-radius:14px"><div><b>Depois</b><p style="margin:.35rem 0 0;color:rgba(246,237,215,.68)">${esc(item.label||item.id||item.src)} será aplicada neste lugar quando você confirmar.</p></div>`};
    select.onchange=renderSelectedPreview;
    el.querySelector('[data-role="apply"]').onclick=()=>{const item=selected();p.src=item.src;if(item.alt&&!p.alt)p.alt=item.alt;mark();save();renderAll();window.alert('Troca confirmada no rascunho. Para aparecer em produção, vá em Publicação > Validar rascunho > Publicar produção.');setTimeout(()=>{document.querySelectorAll('[data-tab="photos"]')[0]?.click()},0)};
    el.querySelector('[data-role="upload"]').onchange=async e=>{await handleUpload(e,p);setTimeout(()=>{document.querySelectorAll('[data-tab="photos"]')[0]?.click()},0)};
    el.querySelector('[data-role="details"]').onclick=()=>el.querySelector('[data-role="advanced"]').classList.toggle('hidden');
    el.querySelector('[data-role="label"]').oninput=e=>{p.label=e.target.value;mark()};
    el.querySelector('[data-role="section"]').oninput=e=>{p.section=e.target.value;mark()};
    el.querySelector('[data-role="page"]').oninput=e=>{p.page=e.target.value;mark()};
    el.querySelector('[data-role="alt"]').oninput=e=>{p.alt=e.target.value;mark()};
    list.appendChild(el)})
}
function renderLinks(){const list=$('#linksList');list.innerHTML='';state.links.forEach((l,i)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Título público</span><input class="field" value="${esc(l.title||l.label)}"></label><label><span>Categoria</span><input class="field" value="${esc(l.category||'')}"></label><label class="full"><span>Resumo</span><textarea class="field" rows="3">${esc(l.excerpt||'')}</textarea></label><label><span>URL</span><input class="field" value="${esc(l.url)}"></label><label><span>Tipo</span><select class="field">${['artigo','notícia','guia','relato','menu','página interna','rede social','parceiro'].map(t=>`<option ${l.type===t?'selected':''}>${t}</option>`).join('')}</select></label><label><span>Fonte</span><input class="field" value="${esc(l.source||'')}"></label><label><span>Data</span><input class="field" type="date" value="${esc(l.date||'')}"></label><label><input type="checkbox" ${l.visible?'checked':''}> publicado/visível</label><label><input type="checkbox" ${l.featured?'checked':''}> destaque</label></div><button class="btn dark" style="margin-top:10px">Remover</button>`;const f=el.querySelectorAll('input,textarea,select');f[0].oninput=e=>{l.title=e.target.value;l.label=e.target.value;mark()};f[1].oninput=e=>{l.category=e.target.value;mark()};f[2].oninput=e=>{l.excerpt=e.target.value;mark()};f[3].oninput=e=>{l.url=e.target.value;mark()};f[4].onchange=e=>{l.type=e.target.value;mark()};f[5].oninput=e=>{l.source=e.target.value;mark()};f[6].oninput=e=>{l.date=e.target.value;mark()};f[7].onchange=e=>{l.visible=e.target.checked;mark()};f[8].onchange=e=>{l.featured=e.target.checked;mark()};el.querySelector('button').onclick=()=>{state.links.splice(i,1);mark();renderLinks();renderPreview()};list.appendChild(el)})}
function renderPresence(){const list=$('#presenceList');list.innerHTML='';state.publicPresence.forEach((item,i)=>{const el=document.createElement('article');el.className='item';el.innerHTML=`<div class="form-grid"><label><span>Veículo</span><input class="field" value="${esc(item.vehicle)}"></label><label><span>Tier / tipo</span><input class="field" value="${esc(item.tier)}"></label><label class="full"><span>Título do card</span><textarea class="field" rows="3">${esc(item.title)}</textarea></label><label class="full"><span>URL original</span><input class="field" value="${esc(item.url)}"></label><label><input type="checkbox" ${item.visible?'checked':''}> visível na home</label></div><button class="btn dark" style="margin-top:10px">Remover</button>`;const f=el.querySelectorAll('input,textarea');f[0].oninput=e=>{item.vehicle=e.target.value;mark()};f[1].oninput=e=>{item.tier=e.target.value;mark()};f[2].oninput=e=>{item.title=e.target.value;mark()};f[3].oninput=e=>{item.url=e.target.value;mark()};f[4].onchange=e=>{item.visible=e.target.checked;mark()};el.querySelector('button').onclick=()=>{state.publicPresence.splice(i,1);mark();renderPresence();renderPreview()};list.appendChild(el)})}
function renderSeo(){if(!$('#seoTitle'))return;$('#seoTitle').value=state.seo.title||'';$('#seoDescription').value=state.seo.description||'';$('#seoCanonical').value=state.seo.canonical||'';$('#seoRobots').value=state.seo.robots||'index, follow';$('#seoOgImage').value=state.seo.ogImage||'';$('#seoTitle').oninput=e=>{state.seo.title=e.target.value;mark()};$('#seoDescription').oninput=e=>{state.seo.description=e.target.value;mark()};$('#seoCanonical').oninput=e=>{state.seo.canonical=e.target.value;mark()};$('#seoRobots').onchange=e=>{state.seo.robots=e.target.value;mark()};$('#seoOgImage').oninput=e=>{state.seo.ogImage=e.target.value;mark()}}
function renderMedia(){const grid=$('#mediaGrid');grid.innerHTML='';const uses=editableImageUses();const options=uses.map(u=>`<option value="${esc(u.id)}">${esc(u.label||u.id)} · ${esc(u.page||'site')}</option>`).join('');allPhotos().forEach(p=>{const usedBy=(state.imageUses||[]).filter(u=>u.src===p.src);const el=document.createElement('div');el.className='media item';el.innerHTML=`<img src="${esc(p.src)}"><strong>${esc(p.label||p.id||'Imagem')}</strong><p><b>Status:</b> ${usedBy.length?`em uso em ${usedBy.length} lugar(es)`:'não usada em nenhum lugar marcado'}</p><p>${usedBy.map(u=>`• ${esc(u.label||u.id)}`).join('<br>')||'Pode ser aplicada manualmente em um lugar abaixo.'}</p><label><span>Aplicar esta imagem em um lugar específico</span><select class="field" data-role="use">${options}</select></label><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px"><button class="btn dark" type="button" data-role="apply">Aplicar no lugar escolhido</button><button class="btn ghost" type="button" data-role="cover">Usar como capa</button></div>`;el.querySelector('[data-role="apply"]').onclick=()=>{const id=el.querySelector('[data-role="use"]').value;const use=(state.imageUses||[]).find(u=>u.id===id);if(!use)return;use.src=p.src;if(p.alt&&!use.alt)use.alt=p.alt;mark();save();renderAll();window.alert('Imagem aplicada só neste lugar. Para aparecer no site, publique produção.')};el.querySelector('[data-role="cover"]').onclick=()=>{state.home.photo=p.src;mark();renderAll()};grid.appendChild(el)})}

function renderHistory(){const list=$('#historyList');list.innerHTML='';if(!state.history.length){list.innerHTML='<p class="item">Sem versões ainda.</p>';return}state.history.forEach(h=>{const b=document.createElement('button');b.className='item';b.style.textAlign='left';b.innerHTML=`<b>${esc(h.title)}</b><br><small>${esc(h.when)}</small>${h.snapshot?'':'<p>Registro de publicação salvo sem snapshot pesado.</p>'}`;b.disabled=!h.snapshot;b.onclick=()=>{if(!h.snapshot)return;state=structuredClone(h.snapshot);save();renderAll()};list.appendChild(b)})}
function renderPreview(){const activeLinks=state.links.filter(l=>l.visible);$('#preview').innerHTML=`<section class="hero"><img src="${esc(state.home.photo||state.photos[0]?.src||'')}"><div class="hero-content"><span class="pill">Gondwana FC</span><h2 class="display">${esc(state.home.title)}</h2><p>${esc(state.home.body)}</p><button class="btn lime">${esc(state.home.cta)}</button></div></section><section class="preview-section"><h2 class="display">Projetos</h2>${state.projects.filter(p=>p.featured).map(p=>`<article class="preview-card"><b>${esc(p.title)}</b><p>${esc(p.desc)}</p></article>`).join('')}<h2 class="display">Fotos conectadas</h2><div class="photo-grid">${editableImageUses().map(p=>`<div class="media item"><img src="${esc(p.src)}"><strong>${esc(p.label||p.id)}</strong></div>`).join('')}</div><h2 class="display">Links e notícias ativos</h2>${activeLinks.map(l=>`<a class="preview-card" style="display:block;color:var(--ink);text-decoration:none" href="${esc(l.url)}"><small>${esc(l.category||l.type)} ${l.featured?'• destaque':''}</small><br><b>${esc(l.title||l.label)}</b><p>${esc(l.excerpt||'')}</p></a>`).join('')}<h2 class="display">Presença pública</h2>${state.publicPresence.filter(i=>i.visible).map(i=>`<a class="preview-card" style="display:block;color:var(--ink);text-decoration:none" href="${esc(i.url)}"><small>${esc(i.vehicle)} · ${esc(i.tier)}</small><br><b>${esc(i.title)}</b></a>`).join('')}</section>`}
function resizeImage(fileOrSrc,max=1600,quality=.82){return new Promise((resolve,reject)=>{const img=new Image();img.onload=()=>{const scale=Math.min(1,max/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));const ctx=canvas.getContext('2d');ctx.drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/jpeg',quality))};img.onerror=()=>reject(new Error('Não consegui processar a imagem. Tente outro arquivo.'));if(typeof fileOrSrc==='string'){img.src=fileOrSrc}else{const reader=new FileReader();reader.onload=()=>{img.src=reader.result};reader.onerror=()=>reject(new Error('Não consegui ler o arquivo.'));reader.readAsDataURL(fileOrSrc)}})}

async function validateDraft(showOk=true){const box=$('#validationBox');if(!box)return true;box.textContent='validando rascunho...';const payload={publicPresence:state.publicPresence,photos:state.photos,sitePhotos:state.sitePhotos,imageUses:state.imageUses};try{const response=await fetch('/api/cms/validate',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const result=await response.json();const issues=result.issues||[];box.innerHTML=issues.length?`<b>${result.errors} erro(s), ${result.warnings} alerta(s)</b><div style="margin-top:10px">${issues.map(i=>`<p><b>${esc(i.severity)}:</b> ${esc(i.message)}</p>`).join('')}</div>`:'Rascunho validado sem erros.';if(showOk&&!issues.length)window.alert('Rascunho validado sem erros.');return !!result.ok}catch(error){box.textContent=error.message||'Falha ao validar rascunho';return false}}

async function compressStateImages(){const convert=async p=>{if(p&&typeof p.src==='string'&&p.src.startsWith('data:image/'))p.src=await resizeImage(p.src,1600,.82);return p};state.photos=await Promise.all(state.photos.map(convert));state.sitePhotos=state.photos;state.imageUses=await Promise.all(state.imageUses.map(convert));state.uploads=await Promise.all(state.uploads.map(convert));if(state.home?.photo?.startsWith('data:image/'))state.home.photo=await resizeImage(state.home.photo,1600,.82)}
function responseErrorMessage(text,status){if(/request entity too large/i.test(text)||status===413)return'Imagem muito pesada para publicar. Recarregue a página, suba a imagem de novo e tente publicar; agora o painel comprime antes de enviar.';return text.slice(0,260)||'Falha ao publicar em produção'}
async function dataUrlToFile(dataUrl,name){const response=await fetch(dataUrl);const blob=await response.blob();return new File([blob],name.replace(/\.[^.]+$/,'')+'.jpg',{type:'image/jpeg'})}
async function uploadMedia(file){const password=window.prompt('Senha para publicar a imagem na biblioteca');if(!password)throw new Error('Upload cancelado.');const compressed=await resizeImage(file,1600,.82);const finalFile=await dataUrlToFile(compressed,file.name);const form=new FormData();form.append('password',password);form.append('file',finalFile);const response=await fetch('/api/cms/media',{method:'POST',body:form});const raw=await response.text();let result={};try{result=raw?JSON.parse(raw):{}}catch{throw new Error(responseErrorMessage(raw,response.status))}if(!response.ok||!result.ok)throw new Error(result.error||'Falha ao publicar imagem na biblioteca');return result.asset}
async function handleUpload(e,targetPhoto){const file=e.target.files&&e.target.files[0];if(!file)return;try{$('#status').textContent='publicando imagem na biblioteca...';const asset=await uploadMedia(file);const upload={id:asset.id,label:asset.label,src:asset.src,type:asset.type||'upload',usage:'Imagem publicada pela biblioteca CMS',uploadedAt:asset.uploadedAt};state.uploads.unshift(upload);if(targetPhoto){targetPhoto.src=upload.src;if(!targetPhoto.alt)targetPhoto.alt=upload.label}save();renderAll();$('#status').textContent=targetPhoto?'imagem publicada e aplicada neste lugar':'imagem publicada na biblioteca';window.alert(targetPhoto?'Imagem subida e aplicada neste lugar. Agora vá em Publicação > Validar rascunho > Publicar produção.':'Imagem publicada na biblioteca. Agora selecione onde quer usar.')}catch(error){$('#status').textContent='falha ao subir imagem';window.alert(error.message||'Falha ao processar imagem')}}

