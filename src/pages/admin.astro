const initial={home:{title:'Gondwana FC - Time da Educação',body:'Bola, audiovisual e memória para criar experiências de aprendizagem com escolas, clubes, projetos sociais e organizações.',cta:'Conhecer o Time',photo:basePhotos[0].src},projects:[{id:'a-bola-conecta',title:'A Bola Conecta',desc:'Conteúdo, metodologia e audiovisual para formação pelo futebol.',featured:true},{id:'time-educacao',title:'Time da Educação',desc:'Percursos pedagógicos para escolas, clubes e territórios.',featured:true}],photos:[{id:'hero',label:'Capa principal',where:'Home / primeira dobra',src:basePhotos[0].src,alt:'Gondwana FC em formação e consultoria'},{id:'oficina',label:'Oficina',where:'Home / formação',src:basePhotos[2].src,alt:'Oficina educativa da Gondwana FC'},{id:'territorio',label:'Território',where:'Bloco territorial',src:basePhotos[3].src,alt:'Atuação territorial da Gondwana FC'},{id:'comunidade',label:'Comunidade',where:'Projetos / comunidade',src:basePhotos[5].src,alt:'Comunidade em atividade Gondwana FC'}],links:[{id:'blog-home',label:'Blog do Time',title:'Blog do Time',url:'/blog/',type:'página interna',category:'Editorial',date:'2026-08-08',source:'Gondwana FC',excerpt:'Linha editorial sobre futebol, aprendizagem, cultura, território, audiovisual e memória comunitária.',visible:true,featured:true},{id:'manifesto-campo-pensa',label:'O campo também pensa',title:'O campo também pensa',url:'/blog/#linha',type:'artigo',category:'Manifesto',date:'2026-08-08',source:'Blog do Time',excerpt:'Texto de abertura: por que futebol pode ser método, leitura de grupo e experiência educativa.',visible:true,featured:true},{id:'metodo-abc-blog',label:'A bola chama, a câmera registra, a conversa organiza',title:'A bola chama, a câmera registra, a conversa organiza',url:'/blog/',type:'artigo',category:'Método ABC',date:'2026-08-08',source:'Blog do Time',excerpt:'Explicação simples da metodologia para escolas, clubes, projetos e fundações.',visible:true,featured:true},{id:'lei-10639-futebol',l