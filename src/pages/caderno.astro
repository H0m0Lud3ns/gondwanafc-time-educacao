  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script is:inline>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    AOS.init({ duration: prefersReducedMotion ? 0 : 900, once: true, easing: 'ease-out-cubic', disable: prefersReducedMotion });
    lucide.createIcons();
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        const isOpen = !mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden', isOpen);
        menuToggle.setAttribute('aria-expanded', String(!isOpen));
      });
      document.querySelectorAll('.mobile-link').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          menuToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
    const leadForm = document.getElementById('leadForm');
    if (leadForm) {
      leadForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(leadForm);
        const body = ['Mensagem para o Time da Educação', '', ...[...data.entries()].map(([key, value]) => key + ': ' + value)].join('\n');
        window.location.href = 'mailto:contato@gondwanafc.com.br?subject=' + encodeURIComponent('Mensagem para o Time da Educação') + '&body=' + encodeURIComponent(body);
      });
    }
    const galleryImages = [
      { src: 'assets/56ca6697-02-nao-e-so-chutar-vertical.jpg', alt: 'Duas pessoas do Time da Educação segurando uma bola juntas', caption: 'A bola vira vínculo, conversa e plano de jogo.' },
      { src: 'assets/26245046-comunidad-gondwana.jpg', alt: 'Comunidade reunida em uma atividade Gondwana', caption: 'Comunidade em roda: aprendizagem como encontro vivo.' },
      { src: 'assets/99fba4ba-juego-comunidad.jpg', alt: 'Bolas em uma quadra iluminada', caption: 'O campo como laboratório de cooperação, decisão e convivência.' },
      { src: 'assets/66e243b7-frame_02_3.4s.jpg', alt: 'Integrante da Gondwana sorrindo com uma bola globo', caption: 'O mundo entra no jogo: cultura, memória e imaginação pedagógica.' },
      { src: 'assets/bc785a04-frame_02_96.5s.jpg', alt: 'Pessoa aproximando uma bola da câmera', caption: 'Bola e câmera juntas para provocar autoria e leitura crítica.' },
      { src: 'assets/2423ec38-reel-09.jpg', alt: 'Integrante da Gondwana em campo aberto', caption: 'Educação também acontece fora da sala: corpo, paisagem e presença.' },
      { src: 'assets/34a137cd-reel-05.jpg', alt: 'Duas pessoas em campo aberto durante atividade Gondwana', caption: 'Prática em campo: o jogo como método de escuta.' },
      { src: 'assets/8bd00718-frame_02_5.7s.jpg', alt: 'Duas pessoas conversando durante uma atividade do Time da Educação', caption: 'Facilitação em dupla: observar, perguntar, ajustar o jogo.' },
      { src: 'assets/27a017d7-encuentro-manos.jpg', alt: 'Mãos reunidas em gesto de encontro e colaboração', caption: 'O time se monta no gesto coletivo: ninguém aprende sozinho.' },
      { src: 'assets/enviada-bola-maos.jpg', alt: 'Pessoa segurando uma bola durante atividade educativa', caption: 'A bola abre o jogo: primeiro vínculo, depois aprendizagem.' },
      { src: 'assets/enviada-time-campo.jpg', alt: 'Time em campo durante experiência esportiva', caption: 'O campo como sala ampliada: posições, papéis e cooperação.' },
      { src: 'assets/enviada-grupo-celebracao.jpg', alt: 'Grupo celebrando junto depois de uma atividade', caption: 'Pertencimento se treina em equipe, com gesto e prática.' },
      { src: 'assets/enviada-apresentacao.jpg', alt: 'Apresentação pública sobre educação, cultura e futebol', caption: 'Da prática ao palco: um jeito de compartilhar o que foi aprendido.' },
      { src: 'assets/enviada-oficina-sala.jpg', alt: 'Oficina educativa com participantes em sala', caption: 'A roda organiza conversa, escuta e tomada de decisão coletiva.' },
      { src: 'assets/enviada-bolas.jpg', alt: 'Bolas de futebol reunidas antes de uma atividade', caption: 'Toda aula pode começar com um objeto simples e uma pergunta boa.' }
    ];
    const gallery = document.getElementById('gallery');
    if (gallery) {
      galleryImages.forEach((item, index) => {
        const figure = document.createElement('figure');
        figure.className = 'rounded-[1.35rem] border border-[#11130f]/10 bg-white/70 p-2 image-card transition duration-500 hover:scale-[1.015]';
        figure.setAttribute('data-aos', 'fade-up');
        figure.setAttribute('data-aos-delay', String((index % 5) * 45));
        const img = document.createElement('img');
        img.src = item.src;
        img.alt = item.alt;
        img.loading = 'lazy';
        img.className = 'rounded-[1rem] bg-[#11130f]/10 object-cover';
        const caption = document.createElement('figcaption');
        caption.className = 'px-2 pb-2 pt-3 text-sm leading-relaxed text-[#11130f]/72';
        caption.textContent = item.caption;
        figure.appendChild(img);
        figure.appendChild(caption);
        gallery.appendChild(figure);
      });
    }
    const albumMain = document.getElementById('albumMain');
    const albumCaption = document.getElementById('albumCaption');
    document.querySelectorAll('.album-thumb').forEach((button) => {
      button.addEventListener('click', () => {
        if (!albumMain || !albumCaption) return;
        albumMain.src = button.dataset.src;
        albumMain.alt = button.dataset.alt;
        albumCaption.textContent = button.dataset.caption;
      });
    });
    const navLinks = [...document.querySelectorAll('.nav-link')];
    const observedSections = navLinks.map((link) => document.querySelector(link.getAttribute('href'))).filter(Boolean);
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((link) => link.classList.toggle('nav-active', link.getAttribute('href') === '#' + entry.target.id));
        });
      }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });
      observedSections.forEach((section) => observer.observe(section));
    }
    if (window.gsap && !prefersReducedMotion) {
      gsap.registerPlugin(ScrollTrigger);
      gsap.utils.toArray('.font-display').forEach((el) => {
        gsap.fromTo(el, { y: 32, opacity: 0.88 }, { y: 0, opacity: 1, duration: 1.1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 86%' } });
      });
    }
  </script>
</body>
</html>

