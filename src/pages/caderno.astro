    <section id="por-que" class="paper py-20 sm:py-28 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mb-12 grid lg:grid-cols-[0.82fr_1.18fr] gap-10 items-end">
