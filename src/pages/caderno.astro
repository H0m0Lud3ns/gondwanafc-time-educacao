---
import '../styles/tailwind.css';
---
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Gondwana FC | O Time da Educação</title>
  <meta name="description" content="Gondwana FC - Time da Educação: futebol, câmera e perguntas para criar experiências de aprendizagem em escolas, clubes, ONGs e projetos sociais." />
  <link rel="icon" href="/legacy-assets/logo-gondwana-fc-icon-color.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,500&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <style>
    :root {
      --grafite: #11130f;
      --areia: #f6edd7;
      --ouro: #f2c230;
      --barro: #9e4a2f;
      --verde: #2e6f46;
      --azul: #17243a;
      --osso: #faf8f1;
    }
    html { scroll-behavior: smooth; }
    html, body { max-width: 100%; overflow-x: hidden; }
    :focus-visible {
      outline: 2px solid var(--ouro);
      outline-offset: 4px;
      border-radius: 0.6rem;
    }
    .skip-link {
      position: fixed;
      left: 1rem;
      top: 1rem;
      z-index: 999;
      transform: translateY(-140%);
      border-radius: 999px;
      background: var(--ouro);
      color: var(--grafite);
      padding: .75rem 1rem;
      font-weight: 800;
      transition: transform .2s ease;
    }
    .skip-link:focus-visible { transform: translateY(0); }
    body {
      margin: 0;
      background: var(--grafite);
      color: var(--areia);
      font-family: Manrope, sans-serif;
      overflow-x: hidden;
    }
    main, section { max-width: 100vw; overflow-x: clip; }
    section { scroll-margin-top: 6.5rem; }
    input, select, textarea { font-size: 16px; }
    a, button { -webkit-tap-highlight-color: rgba(242, 194, 48, .22); }
    a[href^="#"], a[href^="mailto:"], a[href^="https://wa.me"], button {
      transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .2s ease, box-shadow .2s ease;
    }
    a[href^="#"]:hover, a[href^="mailto:"]:hover, a[href^="https://wa.me"]:hover, button:hover { transform: translateY(-1px); }
    a[href^="#"]:active, a[href^="mailto:"]:active, a[href^="https://wa.me"]:active, button:active { transform: translateY(0) scale(.99); }
    #main > section:first-child [data-aos] {
      opacity: 1 !important;
      transform: none !important;
    }
    .font-display { font-family: 'Archivo Black', Anton, sans-serif; letter-spacing: -0.04em; }
    .font-anton { font-family: Anton, sans-serif; letter-spacing: 0.01em; }
    .font-serif { font-family: 'IBM Plex Serif', serif; }
    .paper {
      background:
        radial-gradient(circle at 15% 15%, rgba(242, 194, 48, 0.16), transparent 30%),
        radial-gradient(circle at 82% 20%, rgba(158, 74, 47, 0.2), transparent 28%),
        linear-gradient(135deg, #f6edd7 0%, #e8d8b7 100%);
      color: #11130f;
    }
    .dark-field {
      background:
        linear-gradient(120deg, rgba(17, 19, 15, 0.94), rgba(23, 36, 58, 0.88)),
        url('/legacy-assets/9e1c72dd-mapa-supercontinente-gondwana.jpg') center/cover;
    }
    .photo-mask { clip-path: polygon(7% 0, 100% 0, 93% 100%, 0 100%); }
    .soft-mask { border-radius: 48% 52% 54% 46% / 44% 43% 57% 56%; }
    .stroke-title { -webkit-text-stroke: 1px rgba(246, 237, 215, 0.72); color: transparent; }
    .marquee { display: flex; width: max-content; animation: marquee 55s linear infinite; }
    @keyframes marquee { to { transform: translateX(-50%); } }
    .gallery-grid { column-count: 4; column-gap: 1rem; }
    .gallery-grid figure { break-inside: avoid; margin-bottom: 1rem; }
    .gallery-grid img { width: 100%; }
    @media (max-width: 1024px) { .gallery-grid { column-count: 3; } }
    @media (max-width: 640px) { .gallery-grid { column-count: 1; column-gap: 0; } .gallery-grid figure { margin-bottom: 1rem; } }
    .nav-glass { background: rgba(17, 19, 15, 0.72); backdrop-filter: blur(18px); }
    .image-card { box-shadow: 0 24px 80px rgba(0,0,0,.28); }
    .line-field {
      background-image:
        linear-gradient(rgba(246,237,215,.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(246,237,215,.08) 1px, transparent 1px);
      background-size: 52px 52px;
    }
    .fixture-card {
      position: relative;
      overflow: hidden;
    }
    .fixture-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, rgba(246,237,215,.10), transparent 45%, rgba(242,194,48,.12));
      pointer-events: none;
    }
    .scoreline {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .85rem;
      align-items: end;
      border-bottom: 1px solid rgba(246, 237, 215, .14);
      padding-bottom: 1rem;
    }

    .nav-link.nav-active { color: var(--ouro); }
    .nav-link.nav-active::after {
      content: '';
      display: block;
      width: 100%;
      height: 2px;
      margin-top: 18px;
      background: var(--ouro);
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: .001ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .001ms !important;
      }
      a[href^="#"]:hover, a[href^="mailto:"]:hover, a[href^="https://wa.me"]:hover, button:hover,
      a[href^="#"]:active, a[href^="mailto:"]:active, a[href^="https://wa.me"]:active, button:active { transform: none !important; }
      .marquee { animation: none !important; }
    }
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: .75rem;
      font-size: .72rem;
      letter-spacing: .28em;
      text-transform: uppercase;
      font-weight: 800;
    }
    .section-label span {
      display: inline-flex;
      min-width: 2.35rem;
      height: 2.35rem;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: currentColor;
    }
    .section-label span b { color: var(--grafite); }
    details.premium-details { border-top: 1px solid rgba(246, 237, 215, .16); margin-top: 1rem; padding-top: 1rem; }
    details.premium-details summary { cursor: pointer; list-style: none; font-weight: 800; color: var(--ouro); min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    details.premium-details summary::-webkit-details-marker { display: none; }
    details.premium-details summary::after { content: ' +'; }
    details.premium-details[open] summary::after { content: ' -'; }
    header a[href="#inicio"] img {
      height: 3rem;
      width: 3rem;
      object-fit: cover;
      border: 1px solid rgba(246, 237, 215, .22);
      background: rgba(246, 237, 215, .08);
      padding: 2px;
    }
    #gondwana-na-copa .project-visual { position: relative; }
    #gondwana-na-copa .project-caption {
      position: absolute;
      left: 2.5rem;
      right: auto;
      bottom: -1.5rem;
      width: min(460px, calc(100% - 5rem));
      z-index: 2;
    }
    @media (max-width: 1180px) {
      #gondwana-na-copa .copa-feature-grid {
        grid-template-columns: 1fr !important;
      }
      #gondwana-na-copa [data-aos] {
        opacity: 1 !important;
        transform: none !important;
      }
      #gondwana-na-copa .project-copy {
        padding-top: 0 !important;
      }
    }
    @media (max-width: 1023px) {
      #gondwana-na-copa .project-visual { margin-bottom: 2.25rem; }
      #gondwana-na-copa .project-visual > img {
        height: 420px;
        clip-path: none;
        border-radius: 2rem;
        object-position: center;
      }
      #gondwana-na-copa .project-caption {
        position: relative;
        left: auto;
        right: auto;
        bottom: auto;
        width: auto;
        margin: -4.5rem 1rem 0;
      }
      #gondwana-na-copa .project-copy { padding-top: 0; }
    }
    @media (max-width: 640px) {
      header .mx-auto.max-w-7xl { padding-top: .75rem; padding-bottom: .75rem; }
      header a[href="#inicio"] { gap: .65rem; }
      header a[href="#inicio"] img { height: 3.15rem; width: 3.15rem; }
      [data-aos] {
        opacity: 1 !important;
        transform: none !important;
      }
      section .grid,
      section .grid > * {
        min-width: 0;
        max-width: 100%;
      }
      .font-display {
        width: 100%;
        max-width: 100%;
        letter-spacing: -0.04em;
        overflow-wrap: break-word;
        word-break: normal;
      }
      section h2.font-display,
      #gondwana-na-copa .project-copy h2 {
        font-size: clamp(1.8rem, 8vw, 2.35rem) !important;
        line-height: 1 !important;
      }
      section p[class*="tracking-[0.28em]"],
      section p[class*="tracking-[0.25em]"] {
        letter-spacing: .16em !important;
        overflow-wrap: break-word;
      }
      section h3,
      section p,
      section span,
      section a,
      section summary {
        overflow-wrap: break-word;
        word-break: normal;
      }
      #gondwana-na-copa { padding-top: 4.5rem; padding-bottom: 4.5rem; }
      #gondwana-na-copa .project-visual { margin-bottom: 1.75rem; }
      #gondwana-na-copa .project-visual > img { height: 300px; border-radius: 1.6rem; object-position: center; }
      #gondwana-na-copa .project-caption {
        margin: 1rem 0 0;
        padding: 1.15rem;
        border-radius: 1.35rem;
      }
      #gondwana-na-copa .project-caption p:last-child {
        font-size: 1.08rem;
        line-height: 1.36;
      }
      #gondwana-na-copa .project-copy h2 {
        font-size: clamp(2rem, 9vw, 2.65rem);
        line-height: 1;
        overflow-wrap: normal;
        margin-bottom: 1.35rem;
      }
      #gondwana-na-copa .project-copy p {
        position: relative;
        z-index: 1;
      }
    }
    @media (max-width: 480px) {
      section[class*="py-20"], section[class*="py-28"] {
        padding-top: 4rem !important;
        padding-bottom: 4rem !important;
      }
      #inicio {
        scroll-margin-top: 5.75rem;
      }
      .mobile-link:active,
      a[href="/#formulario"]:active,
      a[href="#metodo"]:active {
        box-shadow: inset 0 0 0 999px rgba(246, 237, 215, .08);
      }
    }
  </style>

  <style id="caderno-harmonizacao">
    .caderno-topbar{position:relative;z-index:20;margin-top:72px;background:#11130f;color:#f6edd7;border-bottom:1px solid rgba(246,237,215,.12);font-family:Manrope,Arial,sans-serif}
    .caderno-topbar__inner{max-width:1180px;margin:0 auto;padding:.72rem 1rem;display:flex;gap:1rem;align-items:center;justify-content:space-between;flex-wrap:wrap}
    .caderno-topbar strong{font-weight:900;text-transform:uppercase;letter-spacing:.12em;font-size:.78rem;color:#f2c230}
    .caderno-topbar span{font-size:.9rem;line-height:1.35;color:rgba(246,237,215,.76)}
    .caderno-topbar a{display:inline-flex;min-height:2.65rem;align-items:center;justify-content:center;border-radius:999px;padding:.65rem 1rem;text-decoration:none;font-size:.72rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .caderno-topbar .primary{background:#f2c230;color:#11130f}.caderno-topbar .secondary{border:1px solid rgba(246,237,215,.38);color:#f6edd7}
    @media(max-width:680px){.caderno-topbar{margin-top:70px}.caderno-topbar__inner{align-items:flex-start}.caderno-topbar a{width:100%}}
  </style>
</head>
<body>
  <div class="caderno-topbar" role="note" aria-label="Caderno do Time da Educação">
    <div class="caderno-topbar__inner">
      <div><strong>Caderno do Time</strong><span> Manifesto, método e arquivo de aprofundamento do Gondwana FC.</span></div>
      <div style="display:flex;gap:.5rem;flex-wrap:wrap">
        <a class="primary" href="/#formulario">Chamar o Time</a>
        <a class="secondary" href="/">Página principal</a>
      </div>
    </div>
  </div>

  <a class="skip-link" href="#main">Saltar ao conteúdo</a>
  <header class="fixed top-0 left-0 right-0 z-50 nav-glass border-b border-[#f6edd7]/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
      <a href="#inicio" class="flex items-center gap-3 min-h-11">
        <img src="/legacy-assets/logo-gondwana-fc-badge-color.jpg" alt="Gondwana FC - Time da Educação" class="h-14 w-auto rounded-full border border-[#f6edd7]/20 bg-[#f6edd7] shadow-xl shadow-black/30" />
        <span class="hidden sm:block text-xs uppercase tracking-[0.35em] text-[#f6edd7]/70">Time da Educação</span>
      </a>
      <nav class="hidden xl:flex items-center gap-5 text-sm text-[#f6edd7]/78">
        <a href="#inicio" class="nav-link min-h-11 inline-flex items-center hover:text-[#f2c230]">Início</a>
        <a href="#quem-somos" class="nav-link min-h-11 inline-flex items-center hover:text-[#f2c230]">O Time</a>
        <a href="#por-que" class="nav-link min-h-11 inline-flex items-center hover:text-[#f2c230]">Método ABC</a>
        <a href="#formatos" class="nav-link min-h-11 inline-flex items-center hover:text-[#f2c230]">Temporada</a>
        <a href="#confianca" class="nav-link min-h-11 inline-flex items-center hover:text-[#f2c230]">Confiança</a>
        <a href="#diario" class="nav-link min-h-11 inline-flex items-center hover:text-[#f2c230]">Diário</a>
        <a href="/#formulario" class="nav-link min-h-11 inline-flex items-center hover:text-[#f2c230]">Contato</a>
      </nav>
      <div class="flex items-center gap-2">
        <button id="menuToggle" class="xl:hidden min-h-11 min-w-11 inline-flex items-center justify-center rounded-full border border-[#f6edd7]/20 text-[#f6edd7]" aria-expanded="false" aria-controls="mobileMenu" aria-label="Abrir menu"><i data-lucide="menu"></i></button>
      </div>
    </div>
    <div id="mobileMenu" class="hidden fixed bottom-0 left-0 right-0 top-[4.75rem] min-h-[calc(100vh-4.75rem)] overflow-y-auto border-t border-[#f6edd7]/10 bg-[#11130f] px-4 pb-6 pt-4 shadow-2xl shadow-black/50 xl:hidden">
      <div class="grid gap-2 text-base font-bold">
        <a href="#inicio" class="mobile-link min-h-12 rounded-2xl px-4 py-3 hover:bg-[#f6edd7]/10">Início</a>
        <a href="#quem-somos" class="mobile-link min-h-12 rounded-2xl px-4 py-3 hover:bg-[#f6edd7]/10">O Time</a>
        <a href="#por-que" class="mobile-link min-h-12 rounded-2xl px-4 py-3 hover:bg-[#f6edd7]/10">Método ABC</a>
        <a href="#formatos" class="mobile-link min-h-12 rounded-2xl px-4 py-3 hover:bg-[#f6edd7]/10">Temporada</a>
        <a href="#confianca" class="mobile-link min-h-12 rounded-2xl px-4 py-3 hover:bg-[#f6edd7]/10">Confiança</a>
        <a href="#diario" class="mobile-link min-h-12 rounded-2xl px-4 py-3 hover:bg-[#f6edd7]/10">Diário</a>
        <a href="/#formulario" class="mobile-link min-h-12 rounded-2xl px-4 py-3 hover:bg-[#f6edd7]/10">Contato</a>
      </div>
    </div>
  </header>

  <main id="main" role="main">
    <section id="inicio" class="relative min-h-[auto] sm:min-h-screen overflow-hidden dark-field line-field pt-24 sm:pt-28">
      <div class="absolute inset-0 opacity-40">
        <div class="marquee h-full items-center gap-6">
          <img src="/legacy-assets/enviada-bola-maos.jpg" alt="" role="presentation" class="h-[68vh] w-[36vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-time-campo.jpg" alt="" role="presentation" class="h-[58vh] w-[52vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-grupo-celebracao.jpg" alt="" role="presentation" class="h-[64vh] w-[44vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-oficina-sala.jpg" alt="" role="presentation" class="h-[54vh] w-[48vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-estadio.jpg" alt="" role="presentation" class="h-[68vh] w-[36vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-bola-maos.jpg" alt="" role="presentation" class="h-[68vh] w-[36vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-time-campo.jpg" alt="" role="presentation" class="h-[58vh] w-[52vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-grupo-celebracao.jpg" alt="" role="presentation" class="h-[64vh] w-[44vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-oficina-sala.jpg" alt="" role="presentation" class="h-[54vh] w-[48vh] object-cover rounded-[2rem] opacity-70" />
          <img src="/legacy-assets/enviada-estadio.jpg" alt="" role="presentation" class="h-[68vh] w-[36vh] object-cover rounded-[2rem] opacity-70" />
        </div>
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#11130f]/60 via-[#11130f]/76 to-[#11130f]"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 min-h-0 sm:min-h-[calc(100vh-7rem)] flex items-start sm:items-end pb-10 sm:pb-20">
        <div class="grid w-full min-w-0 gap-10 items-end lg:grid-cols-[minmax(0,1fr)_320px] xl:grid-cols-[minmax(0,1fr)_360px]">
          <div data-aos="fade-up" class="min-w-0">
            <p class="mb-5 inline-flex items-center gap-3 rounded-full border border-[#f2c230]/40 bg-[#11130f]/70 px-4 py-2 text-xs uppercase tracking-[0.32em] text-[#f2c230]">Gondwana FC - Time da Educação</p>
            <h1 class="font-display max-w-full text-[11.5vw] leading-[0.82] sm:text-[10vw] lg:text-[6.7rem] xl:text-[7.4rem] 2xl:text-[8.6rem] uppercase">O Time<br>da Educação</h1>
            <div class="mt-8 max-w-3xl grid gap-5 sm:grid-cols-[1.1fr_.9fr] items-end">
              <div class="grid gap-3">
                <p class="text-xl sm:text-2xl text-[#f6edd7]/88 font-serif leading-snug">Uma bola no centro. Uma câmera ligada. Um grupo aprendendo a olhar para si, para o outro e para o lugar onde vive.</p>
                <p class="text-base sm:text-lg text-[#f2c230]/95 font-bold leading-snug">Aqui, cada encontro funciona como uma partida de aprendizagem: entra bola, câmera, pergunta e escuta.</p>
              </div>
              <div class="flex flex-col sm:flex-row gap-3">
                <a href="/#formulario" class="min-h-12 inline-flex items-center justify-center rounded-full bg-[#f2c230] px-5 py-3 font-extrabold text-[#11130f] hover:bg-[#f6edd7] transition">Levar o time</a>
                <a href="#formatos" class="min-h-12 inline-flex items-center justify-center rounded-full border border-[#f6edd7]/35 px-5 py-3 font-bold text-[#f6edd7] hover:bg-[#f6edd7]/10 transition">Ver temporada</a>
              </div>
            </div>
          </div>
          <aside data-aos="fade-left" data-aos-delay="250" class="fixture-card rounded-[2rem] border border-[#f6edd7]/15 bg-[#11130f]/78 p-5 backdrop-blur-xl">
            <p class="text-sm uppercase tracking-[0.25em] text-[#f2c230]">Próxima partida da educação</p>
            <div class="mt-5 rounded-3xl bg-[#f6edd7] p-5 text-[#11130f]">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-xs uppercase tracking-[0.22em] font-extrabold text-[#9e4a2f]">Temporada aberta</p>
                  <strong class="mt-2 block text-3xl font-extrabold leading-none">Bola + Câmera</strong>
                </div>
                <span class="rounded-full bg-[#11130f] px-3 py-1 text-xs font-extrabold uppercase tracking-[0.18em] text-[#f2c230]">A combinar</span>
              </div>
              <p class="mt-4 text-sm font-bold leading-relaxed text-[#11130f]/72">Uma instituição chama o time, apresenta seu grupo e desenhamos a partida pedagógica: escuta, campo, registro e devolutiva.</p>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-3">
              <div class="rounded-2xl bg-[#2e6f46] p-4 text-white"><span class="block text-xs uppercase tracking-[0.18em] text-[#f2c230]">Mandante</span><strong class="mt-2 block leading-tight">Escola, clube ou projeto</strong></div>
              <div class="rounded-2xl bg-[#9e4a2f] p-4 text-white"><span class="block text-xs uppercase tracking-[0.18em] text-[#f2c230]">Visitante</span><strong class="mt-2 block leading-tight">Gondwana FC</strong></div>
            </div>
            <a href="/#formulario" class="mt-4 min-h-12 inline-flex w-full items-center justify-center rounded-full bg-[#f2c230] px-5 py-3 font-extrabold text-[#11130f] hover:bg-[#f6edd7] transition">Marcar partida</a>
          </aside>
        </div>
      </div>
    </section>

    <section id="mapa" class="bg-[#11130f] py-10 sm:py-14 border-y border-[#f6edd7]/10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
