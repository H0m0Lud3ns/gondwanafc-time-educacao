---
import cmsState from '../../data/cms-state.json';
const initialState = JSON.stringify(cmsState);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Editor visual - Gondwana FC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Manrope:wght@500;700;900&display=swap" rel="stylesheet" />
  <style>
    :root{--grafite:#11130f;--verde:#2e6f46;--ouro:#f2c230;--areia:#f6edd7;--barro:#9e4a2f;--ink:#171914}
    *{box-sizing:border-box}body{margin:0;background:var(--grafite);color:var(--areia);font-family:Manrope,sans-serif}button,input,select{font:inherit}.display{font-family:'Archivo Black',sans-serif;letter-spacing:-.05em;text-transform:uppercase}.gate{position:fixed;inset:0;z-index:20;display:grid;place-items:center;background:radial-gradient(circle at 30% 20%,rgba(242,194,48,.22),transparent 28rem),var(--grafite)}.gate.hidden{display:none}.gate-card{width:min(92vw,430px);border:1px solid rgba(246,237,215,.14);border-radius:28px;background:rgba(246,237,215,.08);padding:28px}.field{width:100%;border:1px solid rgba(246,237,215,.18);border-radius:16px;background:rgba(246,237,215,.1);color:var(--areia);padding:13px}.btn{min-height:44px;border:0;border-radius:999px;padding:12px 16px;font-weight:950;cursor:pointer}.btn.gold{background:var(--ouro);color:var(--grafite)}.btn.dark{background:var(--verde);color:white}.btn.ghost{border:1px solid rgba(246,237,215,.22);background:rgba(246,237,215,.07);color:var(--areia)}.shell{display:grid;grid-template-columns:1fr 380px;min-height:100vh}.stage{position:relative;background:#050605}.toolbar{position:sticky;top:0;z-index:8;display:flex;gap:10px;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(246,237,215,.12);background:rgba(17,19,15,.94);padding:12px 14px}.toolbar-left,.toolbar-right{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.toolbar select{width:auto;min-width:170px}.frame-wrap{position:relative;height:calc(100vh - 70px);overflow:auto}iframe{display:block;width:100%;height:100%;border:0;background:white}.overlay{position:absolute;inset:0;pointer-events:none}.hotspot{position:absolute;z-index:5;border:0;border-radius:999px;background:var(--ouro);box-shadow:0 8px 22px rgba(0,0,0,.28);pointer-events:auto;cursor:pointer;color:var(--grafite);padding:7px 10px;font-size:11px;font-weight:950;transition:.16s ease}.hotspot:hover{transform:translateY(-1px) scale(1.03);box-shadow:0 12px 30px rgba(0,0,0,.34)}.hotspot span{display:block;white-space:nowrap}.side{border-left:1px solid rgba(246,237,215,.14);background:linear-gradient(180deg,#171914,#0d0f0c);padding:18px;overflow:auto}.side h1{font-size:34px;line-height:.9;margin:8px 0 10px}.panel{border:1px solid rgba(246,237,215,.13);border-radius:24px;background:rgba(246,237,215,.07);padding:16px;margin-top:14px}.muted{color:rgba(246,237,215,.68);line-height:1.45}.preview-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.preview-grid img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:16px;background:#000}.pill{display:inline-flex;border:1px solid rgba(242,194,48,.5);border-radius:999px;padding:7px 10px;color:var(--ouro);font-size:11px;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.hidden{display:none!important}.status{font-size:13px;color:rgba(246,237,215,.76)}@media(max-width:920px){.shell{grid-template-columns:1fr}.side{border-left:0;border-top:1px solid rgba(246,237,215,.14)}.frame-wrap{height:68vh}}
  </style>
</head>
<body>
  <section id="gate" class="gate"><div class="gate-card"><span class="pill">Editor visual</span><h1 class="display">Entrar no site editável</h1><p class="muted">Navegue, clique na imagem e troque olhando o lugar real.</p><input id="password" class="field" type="password" placeholder="Senha" /><button id="enter" class="btn gold" style="width:100%;margin-top:12px">Entrar</button><p id="loginError" class="hidden" style="color:var(--ouro);font-weight:950">Senha incorreta. Use: gondwana</p></div></section>
  <main class="shell">
    <section class="stage">
      <div class="toolbar"><div class="toolbar-left"><strong>Gondwana FC</strong><select id="page" class="field"><option value="/">Home</option><option value="/caderno/">Caderno</option><option value="/blog/">Blog</option><option value="/manto-abya-yala/">Manto Abya Yala</option></select><button id="reload" class="btn ghost">Recarregar</button><button id="scan" class="btn ghost">Mostrar botões</button><button id="discard" class="btn ghost">Descartar rascunho</button></div><div class="toolbar-right"><span id="status" class="status">rascunho visual</span><button id="publish" class="btn gold">Publicar produção</button></div></div>
      <div class="frame-wrap" id="frameWrap"><iframe id="siteFrame" src="/"></iframe><div id="overlay" class="overlay"></div></div>
    </section>
    <aside class="side">
      <span class="pill">Modo visual</span><h1 class="display">Clique numa imagem</h1><p class="muted">O contorno amarelo mostra imagens que o CMS reconhece. Ao clicar, você troca sem mexer em informações técnicas.</p>
      <div class="panel">
        <b>Selecionar manualmente</b>
        <p class="muted">Se o botão não aparecer sobre a imagem, escolha o lugar aqui.</p>
        <select id="usePicker" class="field"></select>
        <button id="chooseUse" class="btn dark" style="width:100%;margin-top:10px" type="button">Editar lugar escolhido</button>
      </div>
      <div id="empty" class="panel">Nenhuma imagem selecionada ainda.</div>
      <div id="editor" class="panel hidden">
        <p class="pill">Imagem selecionada</p>
        <h2 id="photoTitle" class="display" style="font-size:24px;margin:12px 0"></h2>
        <p id="photoWhere" class="muted"></p>
        <div class="preview-grid"><div><p><b>Atual</b></p><img id="currentImg" alt="" /></div><div><p><b>Depois</b></p><img id="nextImg" alt="" /></div></div>
        <label style="display:block;margin-top:14px"><span>Escolher da biblioteca</span><select id="library" class="field"></select></label>
        <label class="btn dark" style="display:inline-flex;margin-top:12px">Subir nova e aplicar<input id="upload" type="file" accept="image/*" hidden /></label>
        <button id="apply" class="btn gold" style="width:100%;margin-top:12px">Aplicar troca no rascunho</button>
      </div>
      <div class="panel"><b>Publicação</b><p id="pending" class="muted">Nenhuma troca pendente.</p><p class="muted">Depois de aplicar, clique em Publicar produção. A Vercel atualiza o site após o deploy.</p></div>
    </aside>
  </main>
<script is:inline src="/admin/cms-client-state.js"></script>
<script define:vars={{ initialState }}>
const initial=JSON.parse(initialState);
const baseUpdatedAt=initial.updatedAt||'';
let state=loadDraft()||structuredClone(initial);
let selectedPhoto=null;
const $=s=>document.querySelector(s);
const esc=v=>String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const uniqueBy=(items,key)=>{const seen=new Set();return items.filter(item=>item&&item[key]&&!seen.has(item[key])&&seen.add(item[key]))};
const authKey='gfc-cms-auth';
function isAuthed(){try{return Date.now()-Number(localStorage.getItem(authKey)||0)<1000*60*60*12}catch{return false}}
function keepSession(){try{localStorage.setItem(authKey,String(Date.now()))}catch{}}
function unlock(){keepSession();$('#gate').classList.add('hidden')}

function loadDraft(){try{return JSON.parse(localStorage.getItem('gfc-cms-qa')||'null')}catch{localStorage.removeItem('gfc-cms-qa');return null}}
function migrateImageUseIds(){
  const byId=new Map();
  (state.imageUses||[]).forEach(use=>{const id=window.GFC_CMS.resolveImageUseId(use.id);byId.set(id,{...use,id})});
  (initial.imageUses||[]).forEach(use=>{if(!byId.has(use.id))byId.set(use.id,structuredClone(use))});
  state.imageUses=[...byId.values()];
}
function normalizeState(){state.photos=Array.isArray(state.photos)?state.photos:structuredClone(state.sitePhotos||[]);state.sitePhotos=state.photos;state.imageUses=Array.isArray(state.imageUses)?state.imageUses:structuredClone(initial.imageUses||[]);migrateImageUseIds();state.uploads=Array.isArray(state.uploads)?state.uploads:[];state.publicPresence=Array.isArray(state.publicPresence)?state.publicPresence:structuredClone(initial.publicPresence||[])}
function save(){normalizeState();const clean=structuredClone(state);clean.history=[];clean.uploads=(clean.uploads||[]).filter(item=>!String(item.src||'').startsWith('data:image/'));localStorage.setItem('gfc-cms-qa',JSON.stringify(clean));updatePending()}
function allPhotos(){normalizeState();return uniqueBy([...state.photos,...state.imageUses,...state.uploads],'src')}
function pathOf(src){try{return new URL(src,location.origin).pathname}catch{return String(src||'')}}
function labelFromImage(img){const text=img.alt||img.closest('section')?.querySelector('h1,h2,h3')?.textContent||'Imagem do site';return text.trim().slice(0,80)}
function useIdFromImage(img,index){if(img.dataset.cmsUse)return img.dataset.cmsUse;const path=pathOf(img.dataset.cmsOriginal||img.getAttribute('src')||img.currentSrc||img.src);const section=img.closest('section')?.id||'page';const page=$('#page')?.value||'/';return `${page.replace(/[^a-z0-9]+/gi,'-')}-${section}-${index}-${path.split('/').pop()}`.replace(/[^a-z0-9]+/gi,'-').replace(/^-|-$/g,'').toLowerCase()}
function imageUseFor(img,index){const original=pathOf(img.dataset.cmsOriginal||img.getAttribute('src')||img.currentSrc||img.src);const id=useIdFromImage(img,index);const existing=state.imageUses.find(use=>use.id===id);if(existing)return existing;if(!img.dataset.cmsUse)return null;const photo=state.photos.find(p=>pathOf(p.src)===pathOf(img.currentSrc||img.src)||pathOf(p.original)===original);const use={id,label:img.dataset.cmsLabel||labelFromImage(img),page:$('#page')?.value||'/',section:img.closest('section')?.id||'',src:photo?.src||pathOf(img.currentSrc||img.src),alt:img.alt||photo?.alt||'',original};state.imageUses.push(use);return use}
function findPhotoForImage(img,index){return imageUseFor(img,index)}
function syncFrameImages(){
  const frame=$('#siteFrame');const doc=frame.contentDocument;if(!doc)return;
  doc.querySelectorAll('img').forEach((img,index)=>{
    if(!img.dataset.cmsOriginal)img.dataset.cmsOriginal=pathOf(img.getAttribute('src')||img.currentSrc||img.src);
    const photo=findPhotoForImage(img,index);if(!photo||!photo.src)return;
    if(pathOf(img.getAttribute('src')||img.currentSrc||img.src)!==pathOf(photo.src))img.setAttribute('src',photo.src);
    if(photo.alt)img.setAttribute('alt',photo.alt);
  });
}
function initialPhotoSrc(photo){const source=(initial.imageUses||[]).find(item=>item.id===photo.id)||(initial.sitePhotos||initial.photos||[]).find(item=>item.id===photo.id);return source?.src||photo.original||''}
function pendingCount(){return editableUses().filter(p=>p.src&&p.src!==initialPhotoSrc(p)).length}
function pendingPhotos(){return editableUses().filter(p=>p.src&&p.src!==initialPhotoSrc(p))}
function updatePending(){const items=pendingPhotos();const count=items.length;$('#pending').innerHTML=count?`<b>${count} troca(s) pendente(s) no rascunho visual.</b><br>${items.map(p=>esc(p.label||p.id)).join('<br>')}`:'Nenhuma troca pendente.';$('#status').textContent=count?`${count} troca(s) pendente(s)`:'rascunho visual'}
function editableUses(){normalizeState();return (state.imageUses||[]).filter(use=>String(use.id||'').includes('.')||String(use.page||'').toLowerCase().includes('caderno')||String(use.page||'').toLowerCase().includes('home')).sort((a,b)=>`${a.page||''} ${a.section||''} ${a.label||''}`.localeCompare(`${b.page||''} ${b.section||''} ${b.label||''}`))}
function renderUsePicker(){const picker=$('#usePicker');if(!picker)return;const selected=selectedPhoto?.id||'';picker.innerHTML=editableUses().map(use=>`<option value="${esc(use.id)}" ${use.id===selected?'selected':''}>${esc(use.label||use.id)} · ${esc(use.page||'site')}</option>`).join('')}
function scanImages(){
  syncFrameImages();
  const overlay=$('#overlay');overlay.innerHTML='';const frame=$('#siteFrame');const doc=frame.contentDocument;const win=frame.contentWindow;if(!doc||!win)return;
  doc.querySelectorAll('.gfc-visual-hotspot').forEach(item=>item.remove());
  const styleId='gfc-visual-hotspot-style';
  if(!doc.getElementById(styleId)){const style=doc.createElement('style');style.id=styleId;style.textContent='.gfc-visual-hotspot{position:absolute;z-index:2147483647;border:0;border-radius:999px;background:#f2c230;color:#11130f;padding:8px 12px;font:900 12px Manrope,Arial,sans-serif;box-shadow:0 8px 22px rgba(0,0,0,.28);cursor:pointer}.gfc-visual-hotspot:hover{transform:translateY(-1px) scale(1.03)}.gfc-visual-editable{outline:3px solid #f2c230!important;outline-offset:-3px!important;cursor:pointer!important}';doc.head.appendChild(style)}
  let visibleCount=0;
  doc.querySelectorAll('img').forEach((img,index)=>{
    const photo=findPhotoForImage(img,index);if(!photo)return;
    img.classList.add('gfc-visual-editable');
    img.onclick=(event)=>{event.preventDefault();event.stopPropagation();selectPhoto(photo)};
    if(!img.complete){img.addEventListener('load',()=>requestAnimationFrame(scanImages),{once:true});return}
    const rect=img.getBoundingClientRect();if(rect.width<28||rect.height<28)return;if(rect.bottom<0||rect.top>win.innerHeight)return;
    visibleCount+=1;
    const btn=doc.createElement('button');btn.type='button';btn.className='gfc-visual-hotspot';btn.textContent='Trocar';
    const left=Math.max(8,rect.left+win.scrollX+Math.min(Math.max(rect.width-82,8),Math.max(8,rect.width*.08)));
    const top=Math.max(8,rect.top+win.scrollY+Math.min(Math.max(rect.height-38,8),Math.max(8,rect.height*.08)));
    btn.style.left=`${left}px`;btn.style.top=`${top}px`;
    btn.onclick=(event)=>{event.preventDefault();event.stopPropagation();selectPhoto(photo)};doc.body.appendChild(btn);
  });
  $('#status').textContent=visibleCount?`${visibleCount} imagem(ns) editável(is) nesta tela`:'nenhuma imagem editável visível nesta tela';
}
function selectPhoto(photo){selectedPhoto=photo;$('#empty').classList.add('hidden');$('#editor').classList.remove('hidden');$('#photoTitle').textContent=photo.label||photo.id;$('#photoWhere').textContent=photo.where||photo.section||'Uso conectado no site';$('#currentImg').src=photo.src;renderLibrary();renderUsePicker();$('#nextImg').src=$('#library').value||photo.src}
function renderLibrary(){const lib=$('#library');lib.innerHTML=allPhotos().map(p=>`<option value="${esc(p.src)}" ${selectedPhoto&&p.src===selectedPhoto.src?'selected':''}>${esc(p.label||p.src)}</option>`).join('')}
$('#library').onchange=()=>{$('#nextImg').src=$('#library').value};
$('#chooseUse').onclick=()=>{const id=$('#usePicker').value;const photo=(state.imageUses||[]).find(use=>use.id===id);if(photo)selectPhoto(photo)};
$('#apply').onclick=()=>{if(!selectedPhoto)return;selectedPhoto.src=$('#library').value;save();syncFrameImages();selectPhoto(selectedPhoto);scanImages();alert('Troca aplicada no rascunho. Para aparecer no site, clique em Publicar produção.')};
function resizeImage(file,max=1600,quality=.82){return new Promise((resolve,reject)=>{const img=new Image();img.onload=()=>{const scale=Math.min(1,max/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/jpeg',quality))};img.onerror=()=>reject(new Error('Não consegui processar a imagem.'));const reader=new FileReader();reader.onload=()=>{img.src=reader.result};reader.onerror=()=>reject(new Error('Não consegui ler o arquivo.'));reader.readAsDataURL(file)})}
async function dataUrlToFile(dataUrl,name){const response=await fetch(dataUrl);const blob=await response.blob();return new File([blob],name.replace(/\.[^.]+$/,'')+'.jpg',{type:'image/jpeg'})}
async function uploadMedia(file){const password=window.prompt('Senha para publicar a imagem na biblioteca');if(!password)throw new Error('Upload cancelado.');const compressed=await resizeImage(file);const finalFile=await dataUrlToFile(compressed,file.name);const form=new FormData();form.append('password',password);form.append('file',finalFile);const response=await fetch('/api/cms/media',{method:'POST',body:form});const raw=await response.text();const result=raw?JSON.parse(raw):{};if(!response.ok||!result.ok)throw new Error(result.error||'Falha ao publicar imagem');return result.asset}
$('#upload').onchange=async e=>{const file=e.target.files&&e.target.files[0];if(!file||!selectedPhoto)return;try{$('#status').textContent='subindo imagem...';const asset=await uploadMedia(file);state.uploads.unshift({id:asset.id,label:asset.label,src:asset.src,type:asset.type||'upload',usage:'Imagem publicada pelo editor visual',uploadedAt:asset.uploadedAt});selectedPhoto.src=asset.src;save();syncFrameImages();selectPhoto(selectedPhoto);scanImages();alert('Imagem subida e aplicada no rascunho. Agora publique produção.')}catch(error){alert(error.message||'Falha ao subir imagem')}finally{$('#status').textContent='rascunho visual'}};
async function validateDraft(){const response=await fetch('/api/cms/validate',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(window.GFC_CMS.buildValidationPayload(state))});const result=await response.json();if(!result.ok)throw new Error((result.issues||[]).filter(i=>i.severity==='error').map(i=>i.message).join('\n')||'Validação falhou')}
$('#publish').onclick=async()=>{const password=window.prompt('Senha para publicar em produção');if(!password)return;try{$('#status').textContent='validando...';await validateDraft();$('#status').textContent='publicando produção...';const payload=window.GFC_CMS.buildPublishPayload(state,{password,baseUpdatedAt});const response=await fetch('/api/cms/publish',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const raw=await response.text();const result=raw?JSON.parse(raw):{};if(!response.ok||!result.ok)throw new Error(result.error||'Falha ao publicar');localStorage.removeItem('gfc-cms-qa');alert('Publicado em produção. Aguarde o deploy da Vercel atualizar o site.');location.reload()}catch(error){alert(error.message||'Falha ao publicar')}finally{updatePending()}};
$('#page').onchange=()=>{$('#siteFrame').src=$('#page').value};
$('#reload').onclick=()=>{$('#siteFrame').contentWindow.location.reload()};
$('#scan').onclick=()=>scanImages();
$('#discard').onclick=()=>{localStorage.removeItem('gfc-cms-qa');state=structuredClone(initial);normalizeState();renderUsePicker();updatePending();location.reload()};
$('#siteFrame').addEventListener('load',()=>{[300,900,1600,2600].forEach(ms=>setTimeout(scanImages,ms))});
$('#frameWrap').addEventListener('scroll',()=>requestAnimationFrame(scanImages));
$('#siteFrame').addEventListener('load',()=>{$('#siteFrame').contentWindow?.addEventListener('scroll',()=>requestAnimationFrame(scanImages),{passive:true})});
window.addEventListener('resize',()=>requestAnimationFrame(scanImages));
$('#enter').onclick=()=>{$('#password').value.trim().toLowerCase()==='gondwana'?unlock():$('#loginError').classList.remove('hidden')};
$('#password').onkeydown=e=>{if(e.key==='Enter')$('#enter').click()};
if(isAuthed())unlock();
normalizeState();renderUsePicker();updatePending();
</script>
</body>
</html>
